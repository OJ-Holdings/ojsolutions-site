---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookButton from "../components/BookButton.astro";
import { DEMO_AUDIO_SRC, DEMO_AUDIO_TRANSCRIPT, MONTHLY_PRICE, SETUP_PRICE } from "../config";
import { formatPrice, filled } from "../lib/site";
import { mediaAvailable } from "../lib/media";

const hasAudio = mediaAvailable(DEMO_AUDIO_SRC);
const demoTel = "tel:+12624010826";
const demoPhone = "(262) 401-0826";
---

<BaseLayout
  title="AI Receptionist for Local Service Businesses | OJ Solutions"
  description="An AI front desk for home-service businesses that answers calls 24/7, captures customer information, and books on-site estimates. Hear our live demo."
  service="receptionist"
>
  <section class="bg-navy py-16 text-white sm:py-24">
    <div class="container-page max-w-5xl">
      <p class="text-sm font-bold tracking-widest text-gold uppercase">Your AI front desk</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-bold tracking-tight sm:text-6xl">You're on the job. Your phone still gets answered.</h1>
      <p class="mt-6 max-w-2xl text-lg text-white">An AI receptionist that introduces itself, captures your caller's name, address, service, and timeframe, then books an available estimate slot.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="inline-flex min-h-14 items-center justify-center rounded-md bg-gold px-6 font-bold text-navy" href={demoTel}>Call our AI: {demoPhone}</a>
        <BookButton variant="gold" size="lg" label="Request a consultation" />
      </div>
      <p class="mt-4 text-sm text-white">Built for local service businesses. Based in Kenosha, Wisconsin.</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <h2 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">Listen to the front desk before you decide.</h2>
      <p class="mt-5 max-w-3xl text-lg text-muted">The live demo line lets you experience a simulated customer conversation. No personal customer data is used in the example.</p>
      {hasAudio ? (
        <div class="mt-8 max-w-3xl rounded-lg border border-line p-6">
          <audio controls preload="metadata" src={DEMO_AUDIO_SRC.trim()} class="w-full">Your browser does not support audio playback.</audio>
          {filled(DEMO_AUDIO_TRANSCRIPT) && <details class="mt-5"><summary class="link">Read approved transcript</summary><p class="mt-3 whitespace-pre-line text-muted">{DEMO_AUDIO_TRANSCRIPT.trim()}</p></details>}
        </div>
      ) : (
        <div class="mt-8 max-w-3xl rounded-lg border border-line p-6"><p class="font-bold">Call the live demo now.</p><p class="mt-2 text-muted">[APPROVED DEMO RECORDING + TRANSCRIPT – TO ADD]</p><a class="link mt-4 inline-block" href={demoTel}>Call {demoPhone}</a></div>
      )}
    </div>
  </section>

  <section class="border-t border-line py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">What your AI front desk does.</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="rounded-lg border border-line p-6"><h3 class="text-xl font-bold">Answers around the clock</h3><p class="mt-3 text-muted">Use it as overflow when you can't pick up, or let it handle your front desk.</p></article>
        <article class="rounded-lg border border-line p-6"><h3 class="text-xl font-bold">Captures and books</h3><p class="mt-3 text-muted">Collects the information you need and schedules an available on-site estimate.</p></article>
        <article class="rounded-lg border border-line p-6"><h3 class="text-xl font-bold">Sends you the details</h3><p class="mt-3 text-muted">Get a lead alert and find the call recording and transcript in the CRM.</p></article>
      </div>
    </div>
  </section>

  <section class="border-t border-line py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">Straightforward pricing.</h2>
      <div class="mt-7 max-w-xl rounded-lg border border-line p-7">
        <p class="text-muted">AI Receptionist Pro</p>
        <p class="mt-2 font-heading text-5xl font-bold">{formatPrice(MONTHLY_PRICE)} <span class="font-sans text-base font-normal text-muted">/ month</span></p>
        <p class="mt-4 text-muted">One-time setup: <strong class="text-navy">{formatPrice(SETUP_PRICE)}</strong></p>
        <p class="mt-4 text-sm text-muted">Core receptionist, booking, lead notifications, and call history. Additional modules and service terms are confirmed before purchase.</p>
        <BookButton service="receptionist" class="mt-6" label="Request a consultation" />
      </div>
    </div>
  </section>
</BaseLayout>

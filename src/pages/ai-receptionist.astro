---
import ServiceLayout from "../layouts/ServiceLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import IconGrid from "../components/IconGrid.astro";
import CallDemo from "../components/home/CallDemo.astro";
import MissedCallStack from "../components/receptionist/MissedCallStack.astro";
import CallFlow from "../components/receptionist/CallFlow.astro";
import ReceptionistPricing from "../components/receptionist/ReceptionistPricing.astro";
import BuiltFor from "../components/receptionist/BuiltFor.astro";
import { STATS_SOURCE_URL } from "../config";
import { RECEPTIONIST_CORE, RECEPTIONIST_FAQ } from "../lib/receptionist-offer";

const hasStats = /^https?:\/\//i.test(STATS_SOURCE_URL.trim());
---

<ServiceLayout
  service="receptionist"
  title="AI Receptionist That Answers Your Calls | OJ Solutions"
  description="An AI receptionist that answers your calls, captures lead details, and books appointments on your calendar. Call our live AI demo."
  eyebrow="AI Receptionist"
  heading="Your marketing isn't broken. Your phone is."
  highlight="Your phone is."
  subhead="An AI receptionist that answers calls around the clock, captures customer details, and books appointments while you are busy running your business."
  problemHeading="Every missed call is a lead you already paid for."
  faq={RECEPTIONIST_FAQ}
  ctaHeading="See it answer a call"
  ctaLine="Hear our AI live, then talk about setting it up for your business."
  callFirst
>
  <p slot="hero-note" class="text-soft mt-4 max-w-lg text-sm">
    It identifies itself as AI and walks through a pretend estimate request. Use a fake name and address. Calls may be recorded.
  </p>

  <div slot="hero-aside"><CallDemo /></div>

  <Fragment slot="problem">
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Your ads, your website, and word of mouth all make the phone ring. When nobody picks up, that caller goes to a
      competitor, and the money you spent getting them to call goes with them.
    </p>
    {
      hasStats && (
        <figure class="mt-10">
          <p class="font-semibold">In a 2025 CallRail survey of 1,000 consumers:</p>
          <div class="mt-5 grid gap-6 border-y border-line py-7 sm:grid-cols-2 sm:gap-0 sm:divide-x sm:divide-line">
            <div class="sm:pr-8">
              <p class="font-heading text-6xl font-bold tracking-tight">78%</p>
              <p class="mt-2 text-lg text-muted">said they've abandoned a business after an unanswered call.</p>
            </div>
            <div class="sm:pl-8">
              <p class="font-heading text-6xl font-bold tracking-tight">82%</p>
              <p class="mt-2 text-lg text-muted">said they'd call a competitor instead.</p>
            </div>
          </div>
          <figcaption class="mt-3 text-[0.9375rem] text-muted">
            Source:{" "}
            <a href={STATS_SOURCE_URL.trim()} target="_blank" rel="noopener" class="link font-normal">
              CallRail, 2025 consumer survey<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </figcaption>
        </figure>
      )
    }
  </Fragment>

  <div slot="problem-aside"><MissedCallStack /></div>

  <Section id="how-it-works" labelledby="how-title" tone="navy">
    <SectionHeading id="how-title" title="How it works" tone="navy" />
    <CallFlow />
  </Section>

  <Section id="included" labelledby="included-title" border={false}>
    <SectionHeading id="included-title" title="What's included" />
    <IconGrid items={RECEPTIONIST_CORE} />
  </Section>

  <ReceptionistPricing />

  <BuiltFor />
</ServiceLayout>

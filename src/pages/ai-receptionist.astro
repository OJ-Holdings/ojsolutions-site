---
import ServiceLayout from "../layouts/ServiceLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Steps from "../components/Steps.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import BookButton from "../components/BookButton.astro";
import PlaceholderBox from "../components/PlaceholderBox.astro";
import {
  DEMO_AUDIO_SRC,
  DEMO_AUDIO_TRANSCRIPT,
  DEMO_VIDEO_SRC,
  FAQ_ANSWERS,
  GUARANTEE_TEXT,
  MONTHLY_PRICE,
  SETUP_PRICE,
  SHOW_PRICING,
  STATS_SOURCE_URL,
} from "../config";
import { SHOW_PLACEHOLDERS, filled, formatPrice, placeholder } from "../lib/site";
import { mediaAvailable } from "../lib/media";

const hasAudio = mediaAvailable(DEMO_AUDIO_SRC);
const hasVideo = mediaAvailable(DEMO_VIDEO_SRC);
const hasStats = /^https?:\/\//i.test(STATS_SOURCE_URL.trim());
const showPricing = SHOW_PRICING && filled(SETUP_PRICE) && filled(MONTHLY_PRICE);
// iOS Safari shows a blank box for local videos unless a start time is set.
const videoSrc = hasVideo && DEMO_VIDEO_SRC.trim().startsWith("/") && !DEMO_VIDEO_SRC.includes("#")
  ? `${DEMO_VIDEO_SRC.trim()}#t=0.1`
  : DEMO_VIDEO_SRC.trim();

const steps = [
  {
    title: "A call comes in",
    body: "Someone calls your business. Day, night, weekend, or while you're on a job.",
  },
  {
    title: "It answers, quotes, and books",
    body: "The AI picks up, answers their questions, quotes from your prices, and books the appointment.",
  },
  {
    title: "It lands where you work",
    body: "The appointment shows up on your calendar and the contact in your CRM. Anything it can't handle rings your phone.",
  },
];

const included = [
  {
    title: "AI receptionist",
    body: "Answers your calls 24/7, answers common questions, and quotes from your pricing.",
  },
  {
    title: "Booking to your calendar",
    body: "Books the appointment onto your calendar while the caller is still on the phone.",
  },
  {
    title: "Missed-call text-back",
    body: "If a call does get missed, the caller gets a text back so they don't move on.",
  },
  {
    title: "CRM setup",
    body: "We set up your CRM on GoHighLevel. Every caller is saved as a contact you can follow up with.",
  },
  {
    title: "Done-for-you setup and management",
    body: "We set it up with your services, prices, and hours, then keep it running and update it when things change.",
  },
];

const costAnswer = `${formatPrice(SETUP_PRICE)} to set up and ${formatPrice(MONTHLY_PRICE)} a month for maintenance.`;

const faq = [
  {
    q: "Will it sound like a robot?",
    a: hasAudio ? `Don't take our word for it. <a href="#hear-it">Listen to the real call above</a>.` : "",
  },
  {
    q: "What happens with calls it can't handle?",
    a: "It transfers them to your phone or to your staff.",
  },
  { q: "What does it cost?", a: costAnswer },
  {
    q: "Is there a guarantee?",
    a: "We record and analyze the data from every call the receptionist handles, so we can see exactly what it books for you. We'll set up a check-up call to go through the numbers, and if we both agree it isn't making you money, we end the monthly service. The one-time setup fee isn't refunded.",
  },
  {
    q: "How long does setup take?",
    // TODO(Jacob): answer in FAQ_ANSWERS.receptionistSetupTime (src/config.ts).
    // Until then this is a PLACEHOLDER on preview builds and hidden on production.
    a: filled(FAQ_ANSWERS.receptionistSetupTime) ? FAQ_ANSWERS.receptionistSetupTime : placeholder("how long setup takes"),
  },
  {
    q: "What if I don't like the result?",
    a: "We'll set up a check-up call to go through the numbers. If we both agree it isn't helping your business, we end the monthly service and stop billing you. The one-time setup fee isn't refunded.",
  },
  // TODO(Jacob): answer these two in src/config.ts (FAQ_ANSWERS). Hidden until then.
  { q: "Do I need a new phone number?", a: FAQ_ANSWERS.receptionistNewNumber },
  { q: "Is there a long contract?", a: FAQ_ANSWERS.receptionistContract },
];
---

<ServiceLayout
  service="receptionist"
  title="AI Receptionist That Answers Your Calls | OJ Solutions"
  description="An AI receptionist that answers your calls 24/7, quotes from your prices, books jobs on your calendar, and texts back missed calls. We set it up and run it."
  eyebrow="AI Receptionist"
  heading="Your marketing isn't broken. Your phone is."
  highlight="Your phone is."
  subhead="We set up an AI receptionist that answers your calls 24/7, quotes from your prices, and books the job on your calendar while you're busy doing the work."
  problemHeading="Every missed call is a lead you already paid for."
  faq={faq}
  ctaHeading="See it answer a call"
  ctaLine="Book a short call and we'll show you how it would work for your business."
>
  <Fragment slot="hero-secondary">
    {
      filled(GUARANTEE_TEXT) ? (
        <p class="max-w-sm text-base">{GUARANTEE_TEXT.trim()}</p>
      ) : (
        SHOW_PLACEHOLDERS && (
          <p class="max-w-sm text-base">
            <span class="placeholder">PLACEHOLDER: guarantee line</span>
          </p>
        )
      )
    }
    {
      hasAudio && (
        <a href="#hear-it" class="link inline-flex min-h-11 items-center text-lg">
          Hear a real call
        </a>
      )
    }
  </Fragment>

  {
    (hasAudio || hasVideo || SHOW_PLACEHOLDERS) && (
      <div slot="hero-aside" id="hear-it" class="rule-soft scroll-mt-24 rounded-lg border p-5 sm:p-7">
        <h2 class="font-heading text-xl font-bold sm:text-2xl">Hear a real call</h2>
        {hasAudio && <p class="text-soft mt-1">A real call to our AI receptionist, recorded on our own system.</p>}
        {
          hasAudio ? (
            <div class="mt-5">
              <audio controls preload="metadata" src={DEMO_AUDIO_SRC.trim()} class="w-full">
                <a href={DEMO_AUDIO_SRC.trim()} class="link">
                  Download the call recording
                </a>
              </audio>
              {filled(DEMO_AUDIO_TRANSCRIPT) && (
                <details class="group mt-3">
                  <summary class="link inline-flex min-h-11 items-center">Read the transcript</summary>
                  <p class="text-soft mt-3 whitespace-pre-line">{DEMO_AUDIO_TRANSCRIPT.trim()}</p>
                </details>
              )}
            </div>
          ) : (
            <PlaceholderBox class="mt-5" label="demo call recording (audio player)" icon="volume" />
          )
        }
        {
          hasVideo ? (
            <figure class="mt-5">
              <video controls muted playsinline preload="metadata" src={videoSrc} class="w-full rounded-md" />
              <figcaption class="text-soft mt-3">
                Screen recording: the calendar event and the contact card the call created.
              </figcaption>
            </figure>
          ) : (
            <PlaceholderBox
              class="mt-5"
              label="20 to 30 second screen recording of the booking the call created"
              icon="play"
              aspect="16 / 9"
            />
          )
        }
      </div>
    )
  }

  <Fragment slot="problem">
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Your ads, your website, and word of mouth all make the phone ring. When nobody picks up, that caller goes to a
      competitor, and the money you spent getting them to call goes with them.
    </p>
    {
      hasStats && (
        <figure class="mt-12 max-w-4xl">
          <p class="font-semibold">In a 2025 CallRail survey of 1,000 consumers:</p>
          <div class="mt-6 grid gap-8 border-y border-line py-8 sm:grid-cols-2 sm:gap-0 sm:divide-x sm:divide-line">
            <div class="sm:pr-10">
              <p class="font-heading text-6xl font-bold tracking-tight sm:text-7xl">78%</p>
              <p class="mt-3 text-lg text-muted">said they've abandoned a business after an unanswered call.</p>
            </div>
            <div class="sm:pl-10">
              <p class="font-heading text-6xl font-bold tracking-tight sm:text-7xl">82%</p>
              <p class="mt-3 text-lg text-muted">said they'd call a competitor instead.</p>
            </div>
          </div>
          <figcaption class="mt-4 text-[0.9375rem] text-muted">
            Source:{" "}
            <a href={STATS_SOURCE_URL.trim()} target="_blank" rel="noopener" class="link font-normal">
              CallRail, 2025 consumer survey<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </figcaption>
        </figure>
      )
    }
  </Fragment>

  <Section id="how-it-works" labelledby="how-title" tone="navy">
    <SectionHeading id="how-title" title="How it works" tone="navy" />
    <Steps steps={steps} tone="navy" />
  </Section>

  <Section id="included" labelledby="included-title" border={false}>
    <SectionHeading id="included-title" title="What's included" />
    <FeatureGrid items={included} />
  </Section>

  {
    showPricing && (
      <Section id="pricing" labelledby="pricing-title">
        <SectionHeading id="pricing-title" title="Pricing" />
        <div class="mt-8 max-w-xl rounded-lg border border-line p-6 sm:p-8">
          <dl class="grid gap-6 sm:grid-cols-2">
            <div>
              <dt class="text-muted">One-time setup</dt>
              <dd class="mt-1 font-heading text-4xl font-bold tracking-tight">{formatPrice(SETUP_PRICE)}</dd>
            </div>
            <div>
              <dt class="text-muted">Then monthly</dt>
              <dd class="mt-1 font-heading text-4xl font-bold tracking-tight">
                {formatPrice(MONTHLY_PRICE)}
                <span class="font-sans text-base font-normal text-muted">/month</span>
              </dd>
            </div>
          </dl>
          <p class="mt-6 border-t border-line pt-6 text-muted">
            Includes everything above: the AI receptionist, booking, missed-call text-back, CRM setup, and ongoing
            management.
          </p>
          <BookButton service="receptionist" class="mt-6 w-full sm:w-auto" />
        </div>
      </Section>
    )
  }
</ServiceLayout>

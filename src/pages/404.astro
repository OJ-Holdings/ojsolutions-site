---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookButton from "../components/BookButton.astro";
import Icon from "../components/Icon.astro";
import { SERVICES } from "../lib/site";

const links = [{ name: "Home", href: "/" }, ...SERVICES];
---

<BaseLayout
  title="Page Not Found | OJ Solutions"
  description="That page doesn't exist. Head back to the OJ Solutions home page or pick a service."
  noindex
>
  <section class="on-navy" aria-labelledby="not-found-title">
    <div class="container-page grid gap-12 pt-12 pb-20 sm:pt-20 sm:pb-28 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
      <div>
        <h1 id="not-found-title" class="display-1 max-w-[12ch]">This page doesn't exist.</h1>
        <p class="text-soft mt-6 max-w-md text-lg sm:text-xl">
          The link may be old or mistyped. Here's where you can go instead.
        </p>
        <div class="mt-9">
          <BookButton variant="gold" size="lg" />
        </div>
      </div>
      <nav aria-labelledby="not-found-title" class="lg:pt-3">
        <ul role="list" class="rule-soft border-b">
          {
            links.map((l) => (
              <li class="rule-soft border-t">
                <a
                  href={l.href}
                  class="group flex min-h-16 items-center justify-between gap-3 font-heading text-xl font-bold text-white hover:underline hover:decoration-gold hover:decoration-2 hover:underline-offset-4 sm:text-2xl"
                >
                  {l.name}
                  <Icon name="arrow-right" class="size-5 text-gold transition-transform group-hover:translate-x-1" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

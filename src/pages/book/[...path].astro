---
// The /book page: the GoHighLevel calendar, embedded.
// It is only built when GHL_CALENDAR_EMBED is set in src/config.ts.
// (That's why this file has an odd name: it lets the page skip itself.)
//
// Everything after the "?" in the address (service, src, rep, utm_ tags)
// is passed through to the calendar, so it lands on the contact in GHL.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { calendarEmbed } from "../../lib/site";

export function getStaticPaths() {
  return calendarEmbed() ? [{ params: { path: undefined } }] : [];
}

const embed = calendarEmbed()!;
---

<BaseLayout
  title="Book a Call | OJ Solutions"
  description="Pick a time for a short call with OJ Solutions. We'll look at your business and tell you what we'd fix first."
  hideBookButton
>
  <section class="pt-10 pb-14 sm:pt-16 sm:pb-20">
    <div class="container-page">
      <div class="max-w-2xl">
        <span class="block h-1 w-10 rounded-sm bg-gold" aria-hidden="true"></span>
        <h1 class="mt-4 text-[2.25rem] leading-[1.1] font-bold tracking-tight sm:text-5xl">Book a call</h1>
        <p class="mt-4 text-lg text-muted">
          Pick a time that works for you. We'll look at your business and tell you what we'd fix first.
        </p>
      </div>
      <div class="mt-8 overflow-hidden rounded-lg border border-line">
        <iframe
          id={embed.id}
          data-src={embed.src}
          title="Booking calendar"
          class="block min-h-[880px] w-full border-0"
          loading="eager"></iframe>
        <noscript>
          <iframe src={embed.src} title="Booking calendar" class="block min-h-[880px] w-full border-0"></iframe>
        </noscript>
      </div>
    </div>
  </section>

  <script is:inline>
    // Pass this page's query string (service, src, rep, utm_*) to the calendar.
    (() => {
      const frame = document.querySelector("iframe[data-src]");
      if (!frame) return;
      const url = new URL(frame.dataset.src);
      new URLSearchParams(location.search).forEach((value, key) => url.searchParams.set(key, value));
      frame.src = url.toString();
    })();
  </script>
  <script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>
</BaseLayout>

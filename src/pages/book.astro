---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EMAIL } from "../config";
import { filled } from "../lib/site";
import { PRICING, money } from "../data/pricing";

const email = filled(EMAIL) ? EMAIL.trim() : "";
const submitUrl = "https://vgckpcktsfuithqggknd.supabase.co/functions/v1/oj-solutions-consultations";
---
<BaseLayout
  title="Request a 15-Minute Consultation | OJ Solutions"
  description="Pick a time for a 15-minute call with OJ Solutions. Tell us about your business and we'll confirm your time."
  hideBookButton
>
  <section class="on-navy" aria-labelledby="booking-title">
    <div class="container-page pt-12 pb-12 sm:pt-16 sm:pb-16">
      <p class="mb-3 text-sm font-bold tracking-widest text-gold uppercase">OJ Solutions / Book a call</p>
      <h1 class="display-1" id="booking-title">Pick a time. Let's talk.</h1>
      <p class="text-soft mt-5 max-w-2xl text-lg sm:text-xl">
        Pick a 15-minute time, tell us about your business, and send your request.
        We'll contact you to confirm. No account needed.
      </p>
    </div>
  </section>

  <section class="container-page py-12 sm:py-16" aria-labelledby="calendar-title">
    <div class="booking-grid">
      <div class="time-panel">
        <p class="book-eyebrow">01 / SELECT A TIME</p>
        <h2 class="font-heading text-3xl font-bold" id="calendar-title">What works for you?</h2>
        <p class="mt-3 text-muted">Weekdays, 9:00 AM to 4:45 PM Central. Choose a date from tomorrow through the next 30 days.</p>
        <label for="booking-date" class="book-label">Preferred date</label>
        <input type="date" id="booking-date" class="book-input" aria-describedby="booking-date-help" required />
        <p id="booking-date-help" class="mt-2 text-sm text-muted">Monday to Friday only · Central time</p>
        <fieldset class="mt-7">
          <legend class="book-label">Preferred 15-minute start time</legend>
          <div class="slot-grid" id="time-slots" role="group" aria-label="Choose a preferred start time">
            <p class="text-muted">Choose a weekday to see times.</p>
          </div>
        </fieldset>
      </div>

      <div class="details-panel">
        <p class="book-eyebrow">02 / YOUR DETAILS</p>
        <h2 class="font-heading text-3xl font-bold">Tell us a little about your business.</h2>
        <p class="mt-3 text-muted">We'll only use these details to respond to your consultation request.</p>
        <form id="consultation-form" data-submit-url={submitUrl} class="mt-7 space-y-5" novalidate>
          <div class="form-hidden" aria-hidden="true">
            <label for="booking-website">Leave this field blank</label>
            <input type="text" id="booking-website" name="website" tabindex="-1" autocomplete="off"/>
          </div>
          <div>
            <label class="book-label" for="booking-name">Your name *</label>
            <input class="book-input" id="booking-name" name="name" autocomplete="name" maxlength="160" required placeholder="First and last name" />
          </div>
          <div>
            <label class="book-label" for="booking-email">Email *</label>
            <input class="book-input" type="email" id="booking-email" name="email" autocomplete="email" maxlength="200" required placeholder="you@business.com" />
          </div>
          <div>
            <label class="book-label" for="booking-phone">Phone (optional)</label>
            <input class="book-input" type="tel" id="booking-phone" name="phone" autocomplete="tel" maxlength="35" placeholder="Your contact number" />
            <p class="mt-2 text-sm text-muted">A phone number is for this inquiry. Text messages are optional and require your separate agreement below.</p>
            <div class="sms-consent mt-4">
              <input type="checkbox" id="booking-sms-consent" name="smsConsent" value="yes" />
              <div>
                <label for="booking-sms-consent" class="cursor-pointer">I agree to receive text messages from OJ Solutions at the number I provide about this consultation. Consent is not required to request a call. Message and data rates may apply. Reply STOP to opt out or HELP for assistance.</label>
                <p class="mt-1">See our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms</a>.</p>
              </div>
            </div>
          </div>
          <div>
            <label class="book-label" for="booking-business">Business name</label>
            <input class="book-input" id="booking-business" name="business" autocomplete="organization" maxlength="160" placeholder="Your company" />
          </div>
          <div>
            <label class="book-label" for="booking-service">What can we help with?</label>
            <select class="book-input" id="booking-service" name="service">
              <option value="AI receptionist">AI receptionist</option>
              <option value="Websites">Websites</option>
              <option value="Commercials">Video ads</option>
              <option value="Automation">Automation / follow-up systems</option>
              <option value="General consultation">Something else</option>
            </select>
          </div>
          <div id="receptionist-offer-summary" class="mt-2 rounded-lg border border-line bg-white p-4">
            <p class="font-heading text-lg font-bold">AI Receptionist: {money(PRICING.receptionist.monthly)}/month</p>
            <p class="mt-1 text-sm text-muted">Plus a {money(PRICING.receptionist.setup)} one-time setup.</p>
          </div>
          <div>
            <label class="book-label" for="booking-notes">What would you like to improve?</label>
            <textarea class="book-input" id="booking-notes" name="notes" rows="3" maxlength="1000" placeholder="Tell us about missed calls, your website, marketing, or another challenge..."></textarea>
          </div>
          <p class="text-sm text-muted" id="selected-summary">First select your preferred date and time.</p>
          <button type="submit" id="submit-request" class="submit-book" disabled>Request this 15-minute call ↗</button>
          <p class="font-semibold" id="confirm-note">We'll text or email you to confirm your time.</p>
          <p class="text-sm text-muted">Sending a request doesn't sign you up for marketing messages.</p>
          <div id="booking-feedback" role="status" aria-live="polite" class="booking-feedback" hidden></div>
        </form>
        {email && <p class="mt-8 text-muted">Prefer email? <a href={"mailto:" + email + "?subject=" + encodeURIComponent("15-minute consultation request")} class="link">{email}</a></p>}
      </div>
    </div>
  </section>

  <script>
    const dateInput = document.querySelector<HTMLInputElement>("#booking-date");
    const slotsEl = document.querySelector<HTMLElement>("#time-slots");
    const form = document.querySelector<HTMLFormElement>("#consultation-form");
    const select = document.querySelector<HTMLSelectElement>("#booking-service");
    const feedback = document.querySelector<HTMLElement>("#booking-feedback");
    const summary = document.querySelector<HTMLElement>("#selected-summary");
    const sendButton = document.querySelector<HTMLButtonElement>("#submit-request");
    const receptionistOffer = document.querySelector<HTMLElement>("#receptionist-offer-summary");
    let time = "";
    const centralDate = () => {
      const parts = new Intl.DateTimeFormat("en-US", { timeZone: "America/Chicago", year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(new Date());
      const part = (type: string) => parts.find(item => item.type === type)?.value || "";
      return part("year") + "-" + part("month") + "-" + part("day");
    };
    const shift = (iso: string, offset: number) => {
      const dt = new Date(iso + "T12:00:00Z");
      dt.setUTCDate(dt.getUTCDate() + offset);
      return dt.toISOString().slice(0, 10);
    };
    const weekday = (iso: string) => {
      const day = new Date(iso + "T12:00:00Z").getUTCDay();
      return day >= 1 && day <= 5;
    };
    const shortTime = (value: string) => {
      const [hh, mm] = value.split(":").map(Number);
      return ((hh % 12) || 12) + ":" + String(mm).padStart(2, "0") + (hh < 12 ? " AM" : " PM");
    };
    function setFeedback(message: string, isError = false) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.hidden = !message;
      feedback.setAttribute("role", isError ? "alert" : "status");
    }
    function updateSummary() {
      if (sendButton) sendButton.disabled = !time || !dateInput?.value;
      if (summary) summary.textContent = time && dateInput?.value
        ? "Preferred: " + dateInput.value + " at " + shortTime(time) + " Central · 15 minutes · Pending confirmation"
        : "First select your preferred date and time.";
    }
    function drawSlots() {
      if (!dateInput || !slotsEl) return;
      time = "";
      slotsEl.replaceChildren();
      if (!dateInput.value) {
        slotsEl.textContent = "Choose a date to see times.";
      } else if (!weekday(dateInput.value)) {
        slotsEl.textContent = "Please choose Monday through Friday.";
      } else {
        for (let hour = 9; hour <= 16; hour++) for (let minute = 0; minute < 60; minute += 15) {
          const value = String(hour).padStart(2, "0") + ":" + String(minute).padStart(2, "0");
          const button = document.createElement("button");
          button.type = "button";
          button.className = "slot-button";
          button.textContent = shortTime(value);
          button.setAttribute("aria-pressed", "false");
          button.addEventListener("click", () => {
            time = value;
            slotsEl.querySelectorAll<HTMLButtonElement>("button").forEach(b => {
              const selected = b === button;
              b.setAttribute("aria-pressed", String(selected));
              b.classList.toggle("selected", selected);
            });
            updateSummary();
          });
          slotsEl.append(button);
        }
      }
      updateSummary();
    }
    if (dateInput) {
      const today = centralDate();
      dateInput.min = shift(today, 1);
      dateInput.max = shift(today, 30);
      dateInput.addEventListener("change", () => { setFeedback(""); drawSlots(); });
    }
    if (select) {
      const requested = new URLSearchParams(location.search).get("service");
      const mapping: Record<string, string> = { receptionist: "AI receptionist", website: "Websites", commercial: "Commercials", solutions: "General consultation" };
      if (requested && mapping[requested]) select.value = mapping[requested];
      const syncOffer = () => { if (receptionistOffer) receptionistOffer.hidden = select.value !== "AI receptionist"; };
      select.addEventListener("change", syncOffer);
      syncOffer();
    }
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!dateInput || !time || !sendButton || !form || !form.checkValidity() || dateInput.value < dateInput.min || dateInput.value > dateInput.max || !weekday(dateInput.value)) {
        setFeedback("Please choose a valid weekday and 15-minute time, then complete your name and email.", true);
        form?.reportValidity();
        return;
      }
      sendButton.disabled = true;
      sendButton.textContent = "Sending request…";
      setFeedback("");
      const data = new FormData(form);
      const payload = {
        name: String(data.get("name") || ""), email: String(data.get("email") || ""),
        phone: String(data.get("phone") || ""), business: String(data.get("business") || ""),
        service: String(data.get("service") || ""), notes: String(data.get("notes") || ""),
        website: String(data.get("website") || ""), date: dateInput.value, time,
        smsConsent: data.get("smsConsent") === "yes",
      };
      if (payload.smsConsent && payload.phone.replace(/\D/g, "").length < 10) {
        setFeedback("Enter a phone number if you choose to receive text messages.", true);
        sendButton.disabled = false;
        sendButton.textContent = "Request this 15-minute call ↗";
        document.querySelector<HTMLInputElement>("#booking-phone")?.focus();
        return;
      }
      // Do not send production leads or consent records from branch previews.
      if (!["ojsolutions.org", "www.ojsolutions.org"].includes(window.location.hostname)) {
        setFeedback("Preview mode: no booking request was sent. Please use ojsolutions.org/book to request a real consultation.", false);
        sendButton.disabled = false;
        sendButton.textContent = "Request this 15-minute call ↗";
        return;
      }
      try {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 15000);
        let response: Response;
        try {
          response = await fetch(form.dataset.submitUrl || "", {
            method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify(payload), signal: controller.signal,
          });
        } finally { window.clearTimeout(timeout); }
        const result = await response.json().catch(() => ({})) as { message?: string; error?: string; ok?: boolean };
        if (!response.ok || !result.ok) throw new Error(result.error || "We couldn't save your request.");
        const w = window as typeof window & { ojTrack?: (event: string, details?: Record<string, string>) => void };
        const selectedService = payload.service === "AI receptionist" ? "receptionist" : payload.service === "Websites" ? "website" : payload.service === "Commercials" ? "commercial" : "other";
        w.ojTrack?.("book_request_submit", { service: selectedService });
        setFeedback("Request received for " + dateInput.value + " at " + shortTime(time) + " Central. This is not yet confirmed; OJ Solutions will contact you.", false);
        form.reset();
        dateInput.value = "";
        drawSlots();
        sendButton.textContent = "Request received";
        return;
      } catch (error) {
        setFeedback(error instanceof Error ? error.message : "Could not send the request. Please email us.", true);
      }
      sendButton.disabled = false;
      sendButton.textContent = "Request this 15-minute call ↗";
    });
  </script>
  <style>
    .booking-grid { display:grid; grid-template-columns: minmax(0,1fr) minmax(0,.95fr); gap:clamp(28px,5vw,85px); }
    .time-panel,.details-panel { min-width:0; }
    .book-eyebrow { font-size:.75rem; letter-spacing:.13em; color:#4a5568; font-weight:800; margin:0 0 16px; }
    .book-label { display:block; margin:26px 0 8px; font-size:.95rem; font-weight:800; }
    .book-input { display:block; width:100%; border:1px solid #b7bfc8; background:#fff; color:#0c213c; padding:12px 14px; border-radius:7px; min-height:50px; font-size:1rem; }
    .book-input:focus-visible,.slot-button:focus-visible,.submit-book:focus-visible { outline:3px solid #c6a24a; outline-offset:3px; }
    textarea.book-input { resize:vertical; }
    .slot-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; padding-top:8px; }
    .slot-button { border:1px solid #c9cdd3; background:white; color:#142a45; border-radius:6px; font-size:.82rem; padding:11px 6px; min-height:44px; text-align:center; cursor:pointer; }
    .slot-button:hover,.slot-button.selected { border-color:#c3a14c; background:#102441; color:#fff; }
    .submit-book { width:100%; border:0; border-radius:8px; min-height:54px; color:#fff; background:#0b1f3a; padding:13px 18px; font-size:1.05rem; font-weight:800; cursor:pointer; }
    .submit-book:disabled { cursor:not-allowed; opacity:.55; }
    .booking-feedback { border:1px solid #8eab91; color:#123f20; background:#ecf9ef; border-radius:6px; padding:14px; margin-top:18px; font-weight:600; }
    .booking-feedback[role="alert"] { border-color:#bc746e; background:#fff1f0; color:#8b2222; }
    .booking-feedback[hidden] { display:none; }
    .sms-consent { display:flex; align-items:flex-start; gap:11px; font-size:.875rem; line-height:1.55; color:#4a5568; cursor:pointer; }
    .sms-consent input { width:20px; height:20px; flex:0 0 20px; margin-top:3px; accent-color:#0b1f3a; }
    .sms-consent a { color:#0b1f3a; font-weight:700; text-decoration:underline; text-decoration-color:#c4a452; text-underline-offset:3px; }
    .sms-consent :focus-visible { outline:3px solid #c4a452; outline-offset:3px; }
    .form-hidden { position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; }
    @media(max-width:850px) { .booking-grid {grid-template-columns:1fr; gap:52px;} }
    @media(max-width:410px) { .slot-grid {grid-template-columns:repeat(3,minmax(0,1fr));} }
  </style>
</BaseLayout>

---
import ServiceLayout from "../layouts/ServiceLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import IconGrid from "../components/IconGrid.astro";
import PricingOptions from "../components/PricingOptions.astro";
import HeroDevices from "../components/websites/HeroDevices.astro";
import PhoneCompare from "../components/websites/PhoneCompare.astro";
import BuildCards from "../components/websites/BuildCards.astro";
import ProcessSteps from "../components/websites/ProcessSteps.astro";
import { PRICING, money } from "../data/pricing";

const web = PRICING.website;
const plan = web.monthlyPlan;

const pricingOptions = [
  {
    name: "One-time build",
    price: money(web.build.price),
    unit: "one time",
    points: [...web.build.features],
    note: `Care plan ${money(web.care.monthly)}/month for hosting, security and small edits.`,
  },
  {
    name: "Monthly",
    price: money(plan.monthly),
    unit: "/month",
    points: [`${money(plan.down)} down`, ...plan.features],
  },
];

const included = [
  {
    icon: "palette",
    title: "Custom design",
    body: "Designed around your business and what you want visitors to do: call you or book.",
  },
  {
    icon: "smartphone",
    title: "Built for phones first",
    body: "Designed for the small screen first, then scaled up for desktop.",
  },
  {
    icon: "phone",
    title: "Click-to-call and booking",
    body: "Your number is one tap away, and customers can book without picking up the phone.",
  },
  {
    icon: "zap",
    title: "Fast load times",
    body: "Built lean, so pages load quickly on a phone.",
  },
  {
    icon: "search",
    title: "Basic Google setup",
    body: "Page titles, descriptions, and a sitemap, so Google can read your site.",
  },
  {
    icon: "rocket",
    title: "Launch handled",
    body: "We put it live for you. Hosting comes with the Care plan or the monthly plan.",
  },
  {
    icon: "pen",
    title: "Copy written for you",
    body: "We draft every page from a short questionnaire, and you approve it before launch.",
  },
  {
    icon: "link",
    title: "Works with your AI receptionist",
    body: "Your site and your phone line feed the same lead list.",
  },
] as const;

const steps = [
  {
    title: "We look at what you have",
    body: "A call to go over your current site, or the lack of one, and what you need it to do.",
  },
  {
    title: "We design and build it",
    body: "You review it and tell us what to change before anything goes live.",
  },
  {
    title: "We launch it",
    body: "We put it live. Hosting is covered by the Care plan or the monthly plan.",
  },
];

const faq = [
  {
    q: "Can you redo my current site?",
    a: "Yes. We can rebuild what you have or start fresh.",
  },
  {
    q: "Do I own my website?",
    a: `With the one-time build, yes, from day one. On the monthly plan, it's yours after the ${plan.minimumMonths}-month minimum.`,
  },
  {
    q: "How long does a build take?",
    a: "Most sites launch within 2 weeks of getting your content.",
  },
  {
    q: "What do I need to give you?",
    a: "Your logo, photos of your work, your services, and any sites you like. We handle the rest.",
  },
  {
    q: "Do you write the words?",
    a: "Yes. We draft every page and you approve it before launch.",
  },
  {
    q: "Can I make changes later?",
    a: "Yes. Small edits are included on the Care plan and the monthly plan. Just text or email us.",
  },
  {
    q: "Will it show up on Google?",
    a: "Every site launches with page titles, descriptions and a sitemap so Google can read it. Rankings take time, and we don't promise a position.",
  },
  {
    q: "Do you handle my domain?",
    a: "We connect the domain you have. If you don't have one, we'll help you buy it in your name.",
  },
  {
    q: "What if I cancel the monthly plan?",
    a: `After the ${plan.minimumMonths}-month minimum you can cancel anytime and keep your site.`,
  },
  {
    q: "Can you add the AI receptionist?",
    a: "Yes. Your site and phone line can feed the same lead list.",
  },
];
---

<ServiceLayout
  service="website"
  title="Websites That Bring In Customers | OJ Solutions"
  description="Fast, phone-first websites with click-to-call and booking built in. New sites or rebuilds, designed, built, launched, and hosted for you."
  eyebrow="Websites"
  heading="Your website should be bringing you customers."
  highlight="customers."
  subhead="We build fast, phone-first sites that make it easy to call or book you."
  problemHeading="Most people find you on their phone."
  faq={faq}
  ctaHeading="Let's look at your site"
  ctaLine="Book a short call. We'll go over what you have and what we'd change."
>
  <HeroDevices slot="hero-aside" />

  <p slot="hero-note" class="text-soft mt-6 max-w-xl">
    See our work:{" "}
    <a href="https://ojexteriorcare.com" target="_blank" rel="noopener" class="link py-3">ojexteriorcare.com<span class="sr-only"> (opens in a new tab)</span></a>{" "}
    and the site you're on now.
  </p>

  <Fragment slot="problem">
    <div class="mt-6 max-w-2xl space-y-4 text-lg text-muted">
      <p>
        If your site is slow, looks dated, or makes it hard to call or book, they don't stick around to figure it out.
        They go back to search and call someone else.
      </p>
      <p>They won't tell you why. They just won't call.</p>
    </div>
  </Fragment>

  <Fragment slot="problem-aside">
    <PhoneCompare />
  </Fragment>

  <Section id="our-builds" labelledby="our-builds-title" tone="navy">
    <SectionHeading
      id="our-builds-title"
      title="Our builds"
      intro="Two sites we built for our own businesses. Open them on your phone."
      tone="navy"
    />
    <BuildCards />
  </Section>

  <Section id="included" labelledby="included-title" border={false}>
    <SectionHeading
      id="included-title"
      title="What's included"
      intro="New sites or rebuilds. The site you're on right now is built the same way."
    />
    <IconGrid items={[...included]} />
  </Section>

  <Section id="how-it-works" labelledby="how-title" tone="navy">
    <SectionHeading id="how-title" title="How it works" tone="navy" />
    <ProcessSteps steps={steps} tone="navy" />
  </Section>

  <PricingOptions
    service="website"
    title="Pricing"
    intro="Pay once, or spread it out. Pick what fits your business."
    options={pricingOptions}
  />
</ServiceLayout>

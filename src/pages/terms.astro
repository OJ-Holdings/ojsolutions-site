---
// TODO(Jacob): This is a plain-language template, not legal advice.
// Have it reviewed (ideally by a lawyer) before relying on it, and update
// LAST_UPDATED when you change it.
// TODO(Jacob): Add which state's laws govern these terms once the
// business entity is set up.
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalContact from "../components/LegalContact.astro";
import { BUSINESS_NAME, LEGAL_ENTITY } from "../config";
import { filled } from "../lib/site";

const LAST_UPDATED = "October 25, 2026";
const entity = filled(LEGAL_ENTITY) ? LEGAL_ENTITY.trim() : BUSINESS_NAME;
const named = entity === BUSINESS_NAME ? entity : `${entity} ("${BUSINESS_NAME}")`;
---

<BaseLayout
  title="Terms of Use | OJ Solutions"
  description="The terms for using the OJ Solutions website and receiving text messages from us."
>
  <article>
    <header class="on-navy">
      <div class="container-page pt-12 pb-12 sm:pt-16 sm:pb-16">
        <h1 class="display-1">Terms of Use</h1>
        <p class="text-soft mt-4 text-lg">Last updated: {LAST_UPDATED}</p>
      </div>
    </header>
    <div class="container-page pt-6 pb-16 sm:pt-10 sm:pb-24">
      <div class="prose-page max-w-2xl">
        <p>
          These terms cover your use of this website, run by {named} ("we," "us"). By using the site, you agree to them.
          If you don't agree, please don't use the site.
        </p>

        <h2>Our services</h2>
        <p>
          This website describes the services we offer. Any work we do for you is covered by a separate quote or agreement
          between you and us. If that agreement says something different from these terms, the agreement wins.
        </p>

        <h2>Using the site</h2>
        <p>
          Please use the site for lawful purposes only. Don't try to break it, overload it, or get into parts of it you're
          not meant to access.
        </p>

        <h2>Our content</h2>
        <p>
          The text, design, logo, videos, and other content on this site belong to us. Please don't copy or reuse them
          without our permission.
        </p>

        <h2>Other websites and tools</h2>
        <p>
          Our consultation form accepts preferred 15-minute times only. A submission does not reserve a slot.
          We'll contact you to confirm it. Other services such as website hosting and social media
          may involve outside providers under their own terms and policies.
        </p>

        <h2>Text messages (SMS)</h2>
        <p>
          If you check the separate SMS-consent box on the consultation form, {BUSINESS_NAME} may text
          you about that consultation. Marketing messages require separate agreement, and the box is optional.
        </p>
        <ul>
          <li>Message frequency varies.</li>
          <li>Message and data rates may apply.</li>
          <li>Reply <strong>STOP</strong> to opt out at any time. Reply <strong>HELP</strong> for help.</li>
          <li>Agreeing to receive texts is not a condition of buying anything from us or requesting a consultation.</li>
          <li>Carriers are not responsible for delayed or undelivered messages.</li>
          <li>
            We never share mobile numbers or SMS opt-in consent with third parties or affiliates for marketing purposes.
            See our <a href="/privacy">Privacy Policy</a>.
          </li>
        </ul>

        <h2>No guarantees</h2>
        <p>
          We work hard to keep the information on this site accurate, but it's provided "as is." We don't promise
          specific results from using the site, except where we've agreed to something in writing.
        </p>

        <h2>Limits on liability</h2>
        <p>
          To the extent the law allows, we're not liable for indirect or unexpected losses that come from using this
          website.
        </p>

        <h2>Changes to these terms</h2>
        <p>If we change these terms, we'll post the new version here and update the date at the top.</p>

        <LegalContact topic="these terms" />
      </div>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookButton from "../components/BookButton.astro";

interface Trade {
  slug: string;
  name: string;
  title: string;
  situation: string;
  example: string;
  details: string[];
}
interface Props { trade: Trade; }

const trades: Trade[] = [
  {
    slug: "ai-receptionist-for-pressure-washing",
    name: "Pressure washing",
    title: "You're washing a driveway. The next estimate call still matters.",
    situation: "A new caller asks about house washing, concrete cleaning, or a scheduling window while you're operating equipment.",
    example: "Hi, do you clean vinyl siding? Can someone look at my house next week?",
    details: ["Type of surface or service requested", "Property address and preferred timeframe", "Best contact details for an on-site estimate"],
  },
  {
    slug: "ai-receptionist-for-hvac",
    name: "HVAC",
    title: "On a service call? Your next inquiry still gets answered.",
    situation: "When technicians are on installs or service visits, callers may need to describe an issue or ask for a future assessment.",
    example: "Can someone take a look at my air conditioner? It's not cooling.",
    details: ["Whether the call concerns service or a new installation", "Service address and preferred callback details", "Requested appointment window or need for staff follow-up"],
  },
  {
    slug: "ai-receptionist-for-plumbing",
    name: "Plumbing",
    title: "Under a sink? Don't make every caller leave a voicemail.",
    situation: "A plumbing shop needs to capture details without interrupting a technician in the middle of a job.",
    example: "I have a leak under my kitchen sink. Can someone call me?",
    details: ["What kind of issue the caller describes", "Property and contact details", "Callback request, urgency notes and preferred time"],
  },
  {
    slug: "ai-receptionist-for-landscaping",
    name: "Landscaping",
    title: "Out on the property. Still reachable to the next customer.",
    situation: "Landscaping crews are often away from the office when someone calls about mowing, cleanup, hardscaping, or an estimate.",
    example: "Do you give estimates for spring yard cleanups?",
    details: ["Requested landscape or maintenance work", "Property location and available timeframes", "Caller contact details for an estimate"],
  },
  {
    slug: "ai-receptionist-for-roofing",
    name: "Roofing",
    title: "On the roof. Your front desk stays on the ground.",
    situation: "A roofing company may receive repair and replacement inquiries while the owner is on an inspection or project.",
    example: "Could someone assess a few missing shingles on my roof?",
    details: ["Whether the inquiry is about repair or replacement", "Address and project description", "Preferred inspection time and contact details"],
  },
  {
    slug: "ai-receptionist-for-auto-detailing",
    name: "Auto detailing",
    title: "Hands on the vehicle. Someone still handles the call.",
    situation: "Detailing shops handle customer inquiries while working on a vehicle, often with no one available at the counter.",
    example: "Do you offer interior detailing for SUVs? What appointment options do you have?",
    details: ["Vehicle type and service of interest", "Preferred day or appointment timeframe", "Customer contact information for follow-up"],
  },
];

export function getStaticPaths() {
  return trades.map(trade => ({ params: { trade: trade.slug }, props: { trade } }));
}

const { trade } = Astro.props;
---
<BaseLayout
  title={`AI Receptionist for ${trade.name} | OJ Solutions`}
  description={`An AI front desk for ${trade.name.toLowerCase()} business owners in southeast Wisconsin. Capture callers, gather details, and schedule estimates with an operator-focused setup.`}
>
  <section class="on-navy">
    <div class="container-page grid gap-12 py-16 lg:grid-cols-[1.1fr_.9fr] lg:items-center lg:py-24">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-gold">AI receptionist / {trade.name}</p>
        <h1 class="display-1 mt-5">{trade.title}</h1>
        <p class="text-soft mt-6 max-w-2xl text-lg">{trade.situation} OJ Solutions configures its AI front desk around the work you actually do.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="tel:+12624010826" data-demo-call class="inline-flex min-h-14 items-center rounded-lg bg-gold px-6 text-lg font-bold text-navy">Call our AI: (262) 401-0826</a>
          <BookButton variant="gold" size="lg" service="receptionist" label="Request a 15-min call"/>
        </div>
        <p class="text-soft mt-4 text-sm">Try the demo using a fictional name, address and job description. Calls may be recorded.</p>
      </div>
      <aside class="rounded-lg border border-white/25 p-7">
        <p class="text-sm font-bold tracking-widest text-gold uppercase">Illustrative caller inquiry</p>
        <blockquote class="mt-4 font-heading text-2xl font-bold leading-snug">“{trade.example}”</blockquote>
        <p class="text-soft mt-5 text-sm">Fictional example only. Not a real customer recording or testimonial.</p>
      </aside>
    </div>
  </section>
  <section class="container-page grid gap-12 py-16 lg:grid-cols-[.85fr_1.15fr] lg:py-24">
    <div>
      <h2 class="display-2">Capture the information before the lead disappears.</h2>
      <p class="mt-6 text-lg text-muted">Your AI identifies itself, asks for the essentials, and follows a workflow agreed with your business. It can schedule an available on-site estimate when properly configured. Calls needing an actual person are flagged for callback.</p>
      <p class="mt-5 text-muted">The AI is not a technician and should not diagnose hazards, quote unapproved prices, or promise emergency response.</p>
    </div>
    <div>
      <h3 class="text-2xl font-bold">What it can ask a caller about</h3>
      <ul class="mt-7 space-y-4 border-t border-line">
        {trade.details.map((line, i) => (
          <li class="flex gap-5 border-b border-line py-4">
            <span class="font-bold text-muted">{String(i+1).padStart(2,"0")}</span><span class="text-lg">{line}</span>
          </li>
        ))}
      </ul>
      <p class="mt-7 text-muted">Services, availability, integrations, and approvals are configured for each business. <a href="/ai-receptionist" class="link">Review current package inclusions and pricing</a>.</p>
    </div>
  </section>
  <section class="bg-navy text-white">
    <div class="container-page flex flex-wrap items-center justify-between gap-8 py-12">
      <div><h2 class="display-2">You do the work. We get the phone.</h2><p class="text-soft mt-4">We focus on southeast Wisconsin service-business owners.</p></div>
      <BookButton variant="gold" size="lg" label="Request a 15-minute conversation" />
    </div>
  </section>
</BaseLayout>

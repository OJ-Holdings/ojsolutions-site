---
// Video ads. We don't film: the client sends the idea and their own clips,
// and we edit them into a finished ad in every format. The page is built
// like an editing suite: monitors with timecode, a pinned timeline where
// the clips become an ad, and a film strip of our own commercial.
import ServiceLayout from "../layouts/ServiceLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Steps from "../components/Steps.astro";
import IconGrid from "../components/IconGrid.astro";
import Button from "../components/Button.astro";
import CommercialExamples from "../components/CommercialExamples.astro";
import PricingOptions from "../components/PricingOptions.astro";
import EditMonitor from "../components/commercials/EditMonitor.astro";
import FormatFrames from "../components/commercials/FormatFrames.astro";
import ClipsToAd from "../components/commercials/ClipsToAd.astro";
import WorkShowcase from "../components/commercials/WorkShowcase.astro";
import type { IconName } from "../components/Icon.astro";
import { PRICING, money } from "../data/pricing";
import { mediaAvailable } from "../lib/media";

const hasV2Full = mediaAvailable("/media/OJ_Solutions_Commercial_v2_hero30.mp4");
const hasV2Short = mediaAvailable("/media/OJ_Solutions_Commercial_v2_cut15.mp4");
const fullCut = {
  src: hasV2Full ? "/media/OJ_Solutions_Commercial_v2_hero30.mp4" : "/media/commercial-30.mp4",
  poster: hasV2Full && mediaAvailable("/media/commercial-hero-poster.webp") ? "/media/commercial-hero-poster.webp" : "/media/commercial-30-poster.webp",
  duration: hasV2Full ? 32.1 : 34,
};
const shortCut = {
  src: hasV2Short ? "/media/OJ_Solutions_Commercial_v2_cut15.mp4" : "/media/commercial-15.mp4",
  poster: hasV2Short && mediaAvailable("/media/commercial-v2-cut15-poster.webp") ? "/media/commercial-v2-cut15-poster.webp" : "/media/commercial-15-poster.webp",
  duration: hasV2Short ? 16.4 : 16.8,
};

const video = PRICING.video;

const pricingOptions = [
  {
    name: "Single ad",
    price: money(video.single),
    unit: "per ad",
    points: [...video.singleFeatures],
  },
  {
    name: "Monthly content plan",
    price: money(video.contentPlan.monthly),
    unit: "/month",
    points: [...video.contentPlan.features],
  },
];

const included: { icon: IconName; title: string; body: string }[] = [
  { icon: "bulb", title: "Hook and concept", body: "We shape your idea into an opener that stops the scroll." },
  { icon: "scissors", title: "Edited from your clips", body: "Phone footage works." },
  { icon: "captions", title: "Captions on every video", body: "Every line on screen, easy to read on a phone." },
  { icon: "music", title: "Music and sound", body: "Music and sound timed to the cuts." },
  { icon: "sparkle", title: "Motion graphics and text", body: "Titles, callouts and movement that keep eyes on the ad." },
  {
    icon: "formats",
    title: "Every format",
    body: "Vertical for Reels, TikTok and Shorts, square and wide for feeds, ads and your website.",
  },
];

const steps = [
  { title: "Tell us the idea", body: "A quick call or message about what the ad should say and who it's for." },
  { title: "Send your clips", body: "Upload whatever you've got, rough is fine." },
  { title: "We edit", body: "You get a first cut within 3 business days." },
  { title: "Approve and post", body: "Two rounds of revisions, then every format, ready to post or run as an ad." },
];

const faq = [
  { q: "Do you film?", a: "No. You send the clips and we handle everything after that. Phone footage works great." },
  {
    q: "What should I send?",
    a: "Clips of your work, your team and your results. A few seconds of each is plenty, and we'll tell you if anything's missing.",
  },
  { q: "Who comes up with the idea?", a: "You bring the idea. We shape the hook and structure with you on a quick call." },
  { q: "How fast is it?", a: "First cut within 3 business days." },
  { q: "How many revisions do I get?", a: "Two rounds per video." },
  { q: "Which platforms is it made for?", a: "Reels, TikTok, YouTube Shorts, Facebook, and a version for your website." },
  { q: "Can you run the ads for me?", a: "We deliver ad-ready files. Running the ads isn't included." },
  { q: "Do I own the videos?", a: "Yes. Every finished video is yours to use anywhere." },
];
---

<ServiceLayout
  service="commercial"
  title="Video Ads for Your Business | OJ Solutions"
  description="Send us your idea and the clips you already have. We edit them into a finished video ad for Reels, TikTok, Facebook and your website."
  eyebrow="Video Ads"
  heading="People scroll past photos. They stop for video."
  highlight="stop for video."
  subhead="Send us your idea and the clips you already have. We turn them into a scroll-stopping ad for Reels, TikTok, Facebook and your website."
  problemHeading="If you're not on video, you're easy to miss."
  faq={faq}
  ctaHeading="Got clips? Let's make an ad."
  ctaLine="Book a short call and tell us the idea."
>
  <Button slot="hero-secondary" href="#our-work" variant="outline" size="lg">See the example</Button>

  <figure slot="hero-aside" class="mx-auto w-full max-w-[20rem] lg:mr-0">
    <EditMonitor
      src={fullCut.src}
      poster={fullCut.poster}
      name="OJ_EXTERIOR_CARE_AD"
      label="Watch our commercial"
      duration={fullCut.duration}
    />
    <figcaption class="text-soft mt-3">Our own commercial, shot on real OJ Exterior Care jobs.</figcaption>
  </figure>

  <Fragment slot="problem">
    <p class="mt-6 max-w-xl text-lg text-muted">
      If you're only posting photos, or not posting at all, you're invisible in the feed while your competitors show up.
    </p>
    <p class="mt-4 max-w-xl text-lg text-muted">Every ad we make comes in the shape each place asks for.</p>
  </Fragment>

  <FormatFrames slot="problem-aside" />

  <ClipsToAd />

  <CommercialExamples tone="white">
    <WorkShowcase fullCut={fullCut} shortCut={shortCut} />
  </CommercialExamples>

  <Section id="included" labelledby="included-title" tone="navy">
    <SectionHeading id="included-title" title="What's included" intro="You send the clips. We handle everything after that." tone="navy" />
    <IconGrid items={included} tone="navy" />
  </Section>

  <Section id="how-it-works" labelledby="how-title" border={false} class="border-b border-line">
    <SectionHeading id="how-title" title="How it works" />
    <Steps steps={steps} />
  </Section>

  <PricingOptions
    service="commercial"
    title="Pricing"
    intro="Start with one ad, or keep the feed fed every month."
    options={pricingOptions}
  />
</ServiceLayout>

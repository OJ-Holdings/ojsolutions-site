---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookButton from "../components/BookButton.astro";
import { SERVICES } from "../lib/site";
import { PRICING, money } from "../data/pricing";
import { trades } from "../data/industries";

const details = {
  receptionist: {
    kicker: "Answer",
    price: `${money(PRICING.receptionist.monthly)}/mo + ${money(PRICING.receptionist.setup)} setup`,
    description: "Answers your calls 24/7, books appointments and texts back the calls it misses.",
  },
  website: {
    kicker: "Get found",
    price: PRICING.website.from,
    description: "Fast, phone-first sites with click-to-call and booking built in.",
  },
  commercial: {
    kicker: "Stand out",
    price: PRICING.video.from,
    description: "Short video ads for your social media, your website and paid ads.",
  },
};
---
<BaseLayout title="Our Services | OJ Solutions" description="Three ways we help small businesses: an AI receptionist that answers and books your calls, websites that turn visitors into customers, and video ads. See what each one costs.">
  <section class="on-navy">
    <div class="container-page py-16 sm:py-24">
      <p class="text-sm font-bold uppercase tracking-widest text-gold">OJ Solutions / Services</p>
      <h1 class="display-1 mt-5 max-w-4xl">We fix what's <span class="mark-gold">slowing your business down.</span></h1>
      <p class="text-soft mt-6 max-w-2xl text-xl">We built and tested all of this on our own business first. Here are the three things we do for yours.</p>
    </div>
  </section>
  <section class="container-page py-16 sm:py-24" aria-labelledby="core-service-title">
    <h2 class="display-2" id="core-service-title">Our services</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {SERVICES.map((service, i) => (
        <article class="flex flex-col justify-between rounded-lg border border-line p-6 sm:p-8">
          <div>
            <p class="text-sm font-bold tracking-widest uppercase text-muted">{String(i+1).padStart(2,'0')} / {details[service.key].kicker}</p>
            <h3 class="mt-4 font-heading text-2xl font-bold">{service.name}</h3>
            <p class="mt-3 font-heading text-xl font-bold">{details[service.key].price}</p>
            <p class="mt-4 text-muted">{details[service.key].description}</p>
          </div>
          <a href={service.href} class="mt-8 inline-flex min-h-12 items-center font-bold text-navy underline decoration-gold underline-offset-4">Explore {service.name} <span aria-hidden="true" class="ml-2">↗</span></a>
        </article>
      ))}
    </div>
  </section>
  <section class="container-page pb-14 sm:pb-20" aria-labelledby="industry-title">
    <p class="text-sm font-bold tracking-widest uppercase text-muted">AI for trades</p>
    <h2 class="display-2 mt-3" id="industry-title">AI receptionists for your trade.</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">See how the AI receptionist handles the calls in your line of work.</p>
    <ul class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {trades.map(trade => (
        <li><a href={`/${trade.slug}`} class="flex min-h-16 items-center justify-between gap-3 rounded-lg border border-line p-4 font-bold hover:border-gold hover:underline hover:decoration-gold">
          {trade.name}<span aria-hidden="true">↗</span>
        </a></li>
      ))}
    </ul>
  </section>
  <section class="container-page grid gap-6 border-t border-line py-16 sm:grid-cols-[1fr_auto] sm:items-center">
    <div>
      <h2 class="display-2">Not sure where to start?</h2>
      <p class="mt-4 text-lg text-muted">Book a 15-minute call and tell us what's slowing you down. We'll point you to the right fit.</p>
    </div>
    <BookButton variant="navy" size="lg" label="Request a 15-minute call" />
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FaqSection from "../components/FaqSection.astro";
import FinalCta from "../components/FinalCta.astro";
import BookButton from "../components/BookButton.astro";
import Icon from "../components/Icon.astro";
import CallDemo from "../components/home/CallDemo.astro";
import DemoCallout from "../components/home/DemoCallout.astro";
import MissedCallProblem from "../components/home/MissedCallProblem.astro";
import FrontDeskFeatures from "../components/home/FrontDeskFeatures.astro";
import FrontDeskPricing from "../components/home/FrontDeskPricing.astro";
import OwnWork from "../components/home/OwnWork.astro";
import { BUSINESS_NAME, EMAIL, PHONE, SOCIAL_LINKS } from "../config";
import { SERVICES, filled, type ServiceKey } from "../lib/site";
import { RECEPTIONIST_FAQ } from "../lib/receptionist-offer";

const serviceIcon: Record<ServiceKey, "phone" | "browser" | "camera"> = {
  receptionist: "phone",
  website: "browser",
  commercial: "camera",
};

const site = Astro.site ?? new URL("http://localhost:4321");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": new URL("/#organization", site).href,
      name: BUSINESS_NAME,
      url: new URL("/", site).href,
      logo: new URL("/icon-512.png", site).href,
      ...(filled(EMAIL) && { email: EMAIL }),
      ...(filled(PHONE) && { telephone: PHONE }),
      areaServed: ["Kenosha", "Racine", "Pleasant Prairie", "Southeast Wisconsin"].map(name => ({ "@type": "Place", name })),
      founder: [{ "@type": "Person", name: "Jacob" }, { "@type": "Person", name: "Oscar" }],
      ...(Object.values(SOCIAL_LINKS).some(filled) && { sameAs: Object.values(SOCIAL_LINKS).filter(filled) }),
    },
    {
      "@type": "Service",
      "@id": new URL("/ai-receptionist#service", site).href,
      name: "AI Receptionist Pro",
      serviceType: "AI receptionist and call handling for home-service businesses",
      provider: { "@id": new URL("/#organization", site).href },
      areaServed: ["Kenosha", "Racine", "Pleasant Prairie", "Southeast Wisconsin"].map(name => ({ "@type": "Place", name })),
      url: new URL("/ai-receptionist", site).href,
      description: "AI assistant that identifies itself, captures inquiry details and supports on-site estimate scheduling.",
    },
    {
      "@type": "FAQPage",
      mainEntity: RECEPTIONIST_FAQ.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
}

const steps = [
  { title: "We set up your front desk", body: "We configure the AI for your existing number, services, hours, and calendar." },
  { title: "It answers and books", body: "The AI identifies itself, captures the caller's request, and schedules an estimate." },
  { title: "You get the lead", body: "See who called, what they need, and when the estimate is booked." },
];


---

<BaseLayout
  title="OJ Solutions | Your AI Front Desk for Home-Service Businesses"
  description="An AI receptionist that answers calls, captures leads, and books estimates for home-service businesses in southeast Wisconsin. Hear our live demo."
  jsonLd={jsonLd}
>
  <section class="on-navy overflow-hidden" aria-labelledby="hero-title">
    <div
      class="container-page grid gap-14 pt-12 pb-20 sm:pt-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-10 lg:pt-20 lg:pb-28"
    >
      <div>
        <p class="mb-5 text-sm font-bold tracking-widest text-gold uppercase">Your AI front desk · Kenosha, WI</p>
        <h1 id="hero-title" class="display-1 max-w-[13ch] sm:max-w-none lg:max-w-[12ch]">
          You're on the job. <span class="mark-gold">Your phone still gets answered.</span>
        </h1>
        <p class="text-soft mt-6 max-w-xl text-lg sm:mt-8 sm:text-xl">
          An AI receptionist for home-service businesses in southeast Wisconsin. It answers incoming calls,
          captures leads and books available on-site estimates while you're doing the work.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href="tel:+12624010826" data-demo-call class="inline-flex min-h-14 items-center justify-center rounded-lg bg-gold px-6 text-base font-bold text-navy underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-navy sm:text-lg">Call our AI: (262) 401-0826</a>
          <BookButton variant="gold" size="lg" label="Book a 15-min call" />
        </div>
        <p class="text-soft mt-4 max-w-lg text-sm">Hear it yourself. No sales pitch. Just make the call.</p>
        <p class="text-soft mt-2 max-w-lg text-sm">The AI identifies itself, asks about a pretend job, and walks through an estimate request. Use a fake name and address. Calls may be recorded. <a href="/demo" class="underline decoration-gold underline-offset-4 font-semibold">What happens on the demo call?</a></p>
        <p class="mt-5 text-sm font-bold tracking-wide text-white">Built by business owners, for business owners.</p>
      </div>
      <div id="demo" class="scroll-mt-24"><CallDemo /></div>
    </div>
  </section>

  <DemoCallout />

  <MissedCallProblem />

  <OwnWork />

  <FrontDeskFeatures />

  <Section id="services" labelledby="services-title" border={false}>
    <SectionHeading
      id="services-title"
      title="More ways we help"
      intro="The AI receptionist comes first. We also build websites and commercial content so customers can find you and get in touch."
    />
    <ul role="list" class="mt-12 border-b border-line sm:mt-16">
      {
        SERVICES.map((s) => (
          <li class="group relative grid gap-5 border-t border-line py-8 sm:py-10 md:grid-cols-[auto_minmax(0,1fr)_14rem] md:items-center md:gap-10">
            <span class="flex size-12 items-center justify-center rounded-lg bg-navy text-gold transition-colors group-hover:bg-gold group-hover:text-navy">
              <Icon name={serviceIcon[s.key]} class="size-6" />
            </span>
            <p class="font-heading text-[1.5rem] leading-[1.2] font-medium tracking-tight text-balance sm:text-[2rem] lg:text-[2.25rem]">
              {s.problem}
            </p>
            <a
              href={s.href}
              class="inline-flex min-h-11 items-center gap-2 font-heading text-lg font-bold decoration-gold decoration-2 underline-offset-4 group-hover:underline after:absolute after:inset-0 md:justify-self-end"
            >
              {s.name}
              <Icon name="arrow-right" class="size-5 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="how-we-work" labelledby="how-title" tone="navy">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.4fr)] lg:gap-16">
      <h2 id="how-title" class="display-2">How the AI front desk works</h2>
      <div>
        <p class="how-statement font-heading text-[2.125rem] leading-[1.12] font-bold tracking-tight sm:text-5xl lg:text-[3.75rem]" aria-hidden="true" data-statement>
          {steps.map((step) => <><span class="clause">{step.title}.</span>{" "}</>)}
        </p>
        <ol role="list" class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-8">
          {
            steps.map((step, i) => (
              <li class="rule-soft border-t pt-5">
                <span class="font-heading text-lg font-bold text-gold" aria-hidden="true">{i + 1}</span>
                <h3 class="sr-only">Step {i + 1}: {step.title}</h3>
                <p class="text-soft mt-2 text-lg">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Section>

  <FrontDeskPricing />

  <FaqSection items={RECEPTIONIST_FAQ} title="Questions before you call" />

  <FinalCta
    heading="You do the work. We get the phone."
    line="Hear the live demo at (262) 401-0826, or book a quick call."
  />
</BaseLayout>

<style>
  /* Gold underline under each step. GSAP draws them in on scroll. */
  .clause {
    background: linear-gradient(var(--color-gold), var(--color-gold)) no-repeat 0 92% / 100% 0.09em;
    padding-bottom: 0.04em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .how-statement:global(.is-armed) .clause {
    background-size: 0% 0.09em;
  }
</style>

<script>
  // Homepage only: draw the gold underline under each step, one after
  // another, the first time "How we work" scrolls into view.
  const statement = document.querySelector<HTMLElement>("[data-statement]");
  if (statement && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    statement.classList.add("is-armed");
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        try {
          const { gsap } = await import("gsap");
          gsap.to(statement.querySelectorAll(".clause"), {
            backgroundSize: "100% 0.09em",
            duration: 1,
            ease: "expo.out",
            stagger: 0.5,
          });
        } catch {
          statement.classList.remove("is-armed");
        }
      },
      { threshold: 0.5 },
    );
    io.observe(statement);
  }
</script>

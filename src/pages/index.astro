---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEMO_AUDIO_SRC, DEMO_AUDIO_TRANSCRIPT, MONTHLY_PRICE, SETUP_PRICE, GHL_CALENDAR_EMBED, BOOKING_URL } from "../config";
import { bookingHref, filled, formatPrice } from "../lib/site";
import { mediaAvailable } from "../lib/media";

const demoPhone = "(262) 401-0826";
const demoTel = "tel:+12624010826";
const booking = bookingHref("receptionist") ?? demoTel;
const calendarReady = filled(GHL_CALENDAR_EMBED) || filled(BOOKING_URL);
const bookingLabel = calendarReady ? "Book a 15-minute call" : "Request a 15-minute call";
const hasAudio = mediaAvailable(DEMO_AUDIO_SRC);
const hasTranscript = hasAudio && filled(DEMO_AUDIO_TRANSCRIPT);

const coreFeatures = [
  { number: "01", name: "24/7 call answering", description: "Your AI front desk is available when you're out on the job, closed, or tied up with a customer." },
  { number: "02", name: "Natural conversations", description: "It introduces itself as an AI assistant and speaks with your callers in plain language." },
  { number: "03", name: "Lead qualification", description: "Captures the service, name, address, and preferred timeframe without another voicemail." },
  { number: "04", name: "Estimate booking", description: "Schedules available on-site estimate slots directly onto your connected calendar." },
  { number: "05", name: "Instant lead alerts", description: "The information from the call goes straight to you so you know what comes next." },
  { number: "06", name: "Call history and transcripts", description: "Review what happened inside the CRM instead of trying to remember every conversation." },
];
const extraFeatures = [
  ["Missed-call recovery", "Follow up automatically when a caller doesn't reach you."],
  ["CRM and pipeline", "Track leads from new inquiry to booked estimate and won or lost."],
  ["Online booking", "Let customers reserve a convenient estimate slot."],
  ["Review requests", "Invite customers to leave honest reviews after completed work."],
  ["Follow-up workflows", "Keep quotes, reminders, and previous customers from falling through the cracks."],
  ["Websites and quote forms", "Give visitors a clear way to request service."],
  ["Reporting", "See calls answered, leads captured, and estimates booked."],
];
const faq = [
  ["Is it a real person?", "No. It is an AI receptionist, and it identifies itself as an AI assistant at the start of the call."],
  ["What if someone wants a human?", "The AI captures their information and flags the request for a prompt callback."],
  ["Do I need to change my phone number?", "No. Keep your existing number. The AI can work as overflow when you can't answer or as a full front desk."],
  ["Can it handle my services and prices?", "We configure it around your services, hours, and service area. It can book an on-site estimate rather than guess a price."],
  ["What happens after the call?", "You receive the captured lead details, and the recording and transcript are available in the CRM."],
  ["How long does setup take?", "We'll confirm the setup timeline after reviewing your business and phone configuration."],
  ["Who owns my leads and data?", "Ownership, access, and retention will be described in the service agreement before you sign."],
  ["Is there a contract?", "We'll review the contract and cancellation terms with you before you sign up."],
  ["What does it cost?", "The starting price is $797 per month with a $2,000 one-time setup fee."],
  ["Who's behind OJ Solutions?", "Two local operators who run OJ Exterior Care in Kenosha. We built our own AI receptionist before offering the system to other businesses."],
];
const industryList = ["Exterior cleaning", "HVAC", "Plumbing", "Electrical", "Landscaping", "Roofing and gutters", "Auto detailing", "Painting", "Cleaning services"];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI receptionist for home service businesses",
  description: "AI call answering, lead capture, and estimate booking for southeast Wisconsin service businesses.",
  serviceType: "AI receptionist and appointment booking",
  areaServed: ["Kenosha, Wisconsin", "Racine, Wisconsin", "Pleasant Prairie, Wisconsin"],
  provider: { "@type": "LocalBusiness", name: "OJ Solutions", telephone: "+12624010826", address: { "@type": "PostalAddress", addressLocality: "Kenosha", addressRegion: "WI", addressCountry: "US" } },
};
---

<BaseLayout
  title="AI Receptionist for Home-Service Businesses in Kenosha | OJ Solutions"
  description="You're on the job. Your phone still gets answered. Hear the OJ Solutions AI receptionist capture leads and book estimates. Call our live demo at (262) 401-0826."
  jsonLd={jsonLd}
  hideChrome
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" />
  <div class="oj-landing">
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="OJ Solutions homepage">
          <span class="mark"><img src="/icon-512.png" width="40" height="40" alt="" /></span>
          <span class="brand-name"><strong>OJ</strong> SOLUTIONS<small>YOUR AI FRONT DESK</small></span>
        </a>
        <nav class="main-nav" aria-label="Primary navigation">
          <a href="#how-it-works">How it works</a>
          <a href="#demo">Hear it live</a>
          <a href="#pricing">Pricing</a>
        </nav>
        <div class="header-actions">
          <a class="header-call" href={demoTel} data-track="demo_call_tap">Hear it live <span aria-hidden="true">↗</span></a>
          <a class="header-book" href={booking} data-track="booking_tap">{calendarReady ? "Book a call" : "Request a call"}</a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero section-pad" aria-labelledby="hero-title">
        <div class="shell hero-layout">
          <div class="hero-content">
            <p class="eyebrow"><span class="eyebrow-line"></span> AI RECEPTIONIST FOR HOME-SERVICE BUSINESSES</p>
            <h1 id="hero-title">You're on the job.<br /><em>Your phone still gets answered.</em></h1>
            <p class="hero-text">You're running a business, not sitting behind a desk. Our AI receptionist answers calls 24/7, captures customer details, and books estimates while you focus on the work.</p>
            <div class="button-row">
              <a href={demoTel} class="btn btn-gold" data-track="demo_call_tap">Call our AI: {demoPhone} <span aria-hidden="true">↗</span></a>
              <a href={booking} class="btn btn-outline" data-track="booking_tap">{bookingLabel}</a>
            </div>
            <p class="quiet-note">Hear it in action. No sales pitch. Just make the call.</p>
            <div class="hero-proof"><span class="small-dash"></span> Built by business owners, for business owners.</div>
          </div>
          <div class="demo-visual" aria-label="Illustrative simulated AI receptionist call and lead summary">
            <div class="phone-shell">
              <div class="phone-top"><span>OJ SOLUTIONS / AI FRONT DESK</span><span class="phone-time">00:42</span></div>
              <div class="phone-symbol" aria-hidden="true"><span class="phone-rings">✳</span></div>
              <p class="visual-meta">INCOMING CUSTOMER CALL</p>
              <h2>Mike Reynolds</h2>
              <p class="visual-helper">Fictional example customer</p>
              <div class="phone-status"><span class="status-dot"></span> ANSWERED BY AI</div>
              <div class="waveform" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
              <div class="phone-caption">“Thanks for calling. I'm the AI assistant...”</div>
            </div>
            <div class="lead-card">
              <div class="lead-top"><span>NEW ESTIMATE REQUEST</span><span class="booked-label">CAPTURED</span></div>
              <div class="lead-row"><span>Name</span><strong>Mike Reynolds</strong></div>
              <div class="lead-row"><span>Service</span><strong>Driveway + windows</strong></div>
              <div class="lead-row"><span>Timeframe</span><strong>This week</strong></div>
              <p>Illustrative demo. No real customer data.</p>
            </div>
          </div>
        </div>
        <div class="shell hero-bottom"><span>BASED IN KENOSHA, WISCONSIN</span><span>BUILT FOR PEOPLE WHO DO THE WORK</span></div>
      </section>

      <section class="problem section-pad" aria-labelledby="problem-title">
        <div class="shell split">
          <div>
            <p class="eyebrow ink-eyebrow"><span class="eyebrow-line"></span> THE COST OF A MISSED CALL</p>
            <h2 id="problem-title">Nobody leaves a voicemail anymore.<br /><em>They call the next guy.</em></h2>
          </div>
          <div class="problem-copy">
            <p>You're on a ladder. Under a truck. Halfway through a job.</p>
            <p>Your phone rings. You can't answer. The customer moves on.</p>
            <p>At our own exterior-care business, a typical job is worth about <strong>$400.</strong> A few missed opportunities can add up quickly.</p>
            <p class="heavy">You shouldn't have to choose between doing the work and answering the phone.</p>
          </div>
        </div>
        <div class="shell scenario"><span class="scenario-missed"><span class="signal-red"></span> CALL MISSED</span><span class="scenario-arrow" aria-hidden="true">→</span><span class="scenario-leak">CUSTOMER CALLS THE NEXT COMPANY</span><span class="scenario-arrow" aria-hidden="true">→</span><span class="scenario-outcome">JOB OPPORTUNITY LOST</span></div>
      </section>

      <section id="demo" class="demo-section section-pad" aria-labelledby="demo-title">
        <div class="shell demo-grid">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> LIVE AI DEMONSTRATION</p>
            <h2 id="demo-title">Don't take our word for it.<br /><em>Make the call.</em></h2>
            <p>You'll hear an AI receptionist introduce itself, ask the right questions, and guide a customer through an estimate request.</p>
            <a href={demoTel} class="btn btn-gold" data-track="demo_call_tap">Call the AI: {demoPhone} <span aria-hidden="true">↗</span></a>
            <p class="quiet-note">The fastest way to understand it is to hear it yourself.</p>
          </div>
          <div class="demo-panel">
            <div class="panel-header"><span class="mini-label">01 / HEAR IT IN ACTION</span><span class="panel-indicator">LIVE DEMO LINE</span></div>
            {hasAudio ? (
              <div class="audio-wrap">
                <h3>Inside an AI receptionist call</h3>
                <p>Simulated customer inquiry. Example data only.</p>
                <audio controls preload="metadata" src={DEMO_AUDIO_SRC.trim()} data-track-audio>
                  Your browser does not support the audio element.
                </audio>
                {hasTranscript && (
                  <details class="transcript">
                    <summary>Read the approved transcript</summary>
                    <p>{DEMO_AUDIO_TRANSCRIPT.trim()}</p>
                  </details>
                )}
                {!hasTranscript && <p class="placeholder-note">[APPROVED TRANSCRIPT – TO ADD]</p>}
              </div>
            ) : (
              <div class="audio-pending">
                <div class="audio-icon" aria-hidden="true">◉</div>
                <h3>The real demo is on the phone.</h3>
                <p>The approved recording will be added here. Until then, call the live demo line and hear the conversation for yourself.</p>
                <a href={demoTel} class="panel-link" data-track="demo_call_tap">Tap to call the AI <span aria-hidden="true">↗</span></a>
                <span class="placeholder-note">[APPROVED DEMO MP3 + TRANSCRIPT – TO ADD]</span>
              </div>
            )}
          </div>
        </div>
      </section>

      <section id="how-it-works" class="how section-pad" aria-labelledby="how-title">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow ink-eyebrow"><span class="eyebrow-line"></span> THREE SIMPLE STEPS</p>
            <h2 id="how-title">We handle the phone.<br /><em>You handle the work.</em></h2>
            <p>We set up the system. It answers and captures the lead. You show up to the estimate.</p>
          </div>
          <div class="steps">
            <article><span class="step-num">01 / SETUP</span><div class="step-art" aria-hidden="true">⌘</div><h3>We set up your front desk.</h3><p>We configure your services, business hours, service area, and calendar. Keep your existing number.</p></article>
            <article><span class="step-num">02 / ANSWER</span><div class="step-art" aria-hidden="true">◎</div><h3>It answers, captures, and books.</h3><p>The AI introduces itself, collects the customer's details, and books an available estimate slot.</p></article>
            <article><span class="step-num">03 / ALERT</span><div class="step-art" aria-hidden="true">↗</div><h3>You get the lead alert.</h3><p>See who called, what they need, and when the estimate is scheduled. No digging through voicemails.</p></article>
          </div>
        </div>
      </section>

      <section id="features" class="features section-pad" aria-labelledby="features-title">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> YOUR AI FRONT DESK</p>
            <h2 id="features-title">A front desk that works<br /><em>while you do.</em></h2>
            <p>Built for real incoming calls and the information you need to follow up.</p>
          </div>
          <div class="feature-grid">
            {coreFeatures.map((feature) => (
              <article class="feature"><span class="feature-num">{feature.number}</span><h3>{feature.name}</h3><p>{feature.description}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section class="stack section-pad" aria-labelledby="stack-title">
        <div class="shell split">
          <div>
            <p class="eyebrow ink-eyebrow"><span class="eyebrow-line"></span> MORE THAN CALL ANSWERING</p>
            <h2 id="stack-title">Everything behind<br /><em>the front desk.</em></h2>
            <p class="stack-intro">The AI captures the opportunity. The systems behind it help you follow through. Additional modules are configured to your business.</p>
          </div>
          <div class="stack-list">
            {extraFeatures.map(([name, description], i) => (
              <details class="stack-item"><summary><span class="stack-index">{String(i + 1).padStart(2, "0")}</span><span>{name}</span><span class="expand-icon" aria-hidden="true">+</span></summary><p>{description}</p></details>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="operators section-pad" aria-labelledby="about-title">
        <div class="shell operators-inner">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> BUILT BY OPERATORS</p>
            <h2 id="about-title">We know what it's like<br /><em>to miss a call.</em></h2>
            <p>We run OJ Exterior Care, a pressure washing and window cleaning company serving Kenosha and Racine. We built the AI receptionist on our own business line first.</p>
            <p>We're not selling a system we've never used. We know what happens when you're halfway through a job and the phone starts ringing.</p>
            <p class="operators-bold">Built by business owners, for business owners.</p>
          </div>
          <div class="founder-photo">
            <div class="photo-frame"><span class="photo-num">CLIENT ZERO / OJ EXTERIOR CARE</span><span class="photo-emblem">OJ</span><strong>Real operators.<br />Real field experience.</strong><span class="photo-placeholder">[PHOTO – REAL FIELD SHOT TO ADD]</span></div>
          </div>
        </div>
      </section>

      <section class="industries section-pad" aria-labelledby="industries-title">
        <div class="shell">
          <p class="eyebrow ink-eyebrow"><span class="eyebrow-line"></span> BUILT FOR THE TRADES</p>
          <h2 id="industries-title">If you're doing the work,<br /><em>who's answering the phone?</em></h2>
          <div class="industry-chips">{industryList.map((trade) => <span>{trade}</span>)}</div>
          <p class="location-copy">Based in Kenosha, WI. Serving service businesses across southeast Wisconsin.</p>
        </div>
      </section>

      <section id="pricing" class="pricing section-pad" aria-labelledby="pricing-title">
        <div class="shell price-grid">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> STRAIGHTFORWARD PRICING</p>
            <h2 id="pricing-title">A front desk without another<br /><em>full-time hire.</em></h2>
            <p>Clear pricing for the core AI receptionist setup. We'll discuss any additional modules before you commit.</p>
          </div>
          <div class="price-card">
            <div class="price-top"><span>AI RECEPTIONIST PRO</span><span class="price-flash">01 / FLAGSHIP</span></div>
            <div class="price"><strong>{formatPrice(MONTHLY_PRICE)}</strong><span>/ month</span></div>
            <p class="setup">One-time setup: <strong>{formatPrice(SETUP_PRICE)}</strong></p>
            <div class="price-rule"></div>
            <p class="card-label">CORE CAPABILITIES</p>
            <ul>
              <li>24/7 AI call answering</li><li>Caller details and lead capture</li><li>Estimate calendar booking</li><li>Owner notifications</li><li>Call recordings and transcripts</li><li>Overflow or full-front-desk setup</li>
            </ul>
            <a class="btn btn-gold full-btn" href={booking} data-track="booking_tap">{bookingLabel} <span aria-hidden="true">↗</span></a>
            <p class="price-terms">Additional features and service terms are confirmed before purchase. [CONTRACT AND CANCELLATION TERMS – CONFIRM]</p>
          </div>
        </div>
      </section>

      <section id="faq" class="faqs section-pad" aria-labelledby="faq-title">
        <div class="shell faq-wrap">
          <div><p class="eyebrow ink-eyebrow"><span class="eyebrow-line"></span> THE PRACTICAL QUESTIONS</p><h2 id="faq-title">Straight answers.<br /><em>No tech talk.</em></h2></div>
          <div class="faq-list">{faq.map(([question, answer]) => (
            <details><summary>{question}<span class="faq-plus" aria-hidden="true">+</span></summary><p>{answer}</p></details>
          ))}</div>
        </div>
      </section>

      <section class="closing section-pad" aria-labelledby="closing-title">
        <div class="shell closing-inner">
          <p class="eyebrow"><span class="eyebrow-line"></span> READY TO HEAR THE DIFFERENCE?</p>
          <h2 id="closing-title">Your phone is ringing.<br /><em>Who's picking up?</em></h2>
          <p>You didn't start a business to spend the day returning missed calls. Hear the AI for yourself.</p>
          <div class="button-row centered"><a href={demoTel} class="btn btn-gold" data-track="demo_call_tap">Call our AI: {demoPhone} <span aria-hidden="true">↗</span></a><a href={booking} class="btn btn-outline" data-track="booking_tap">{bookingLabel}</a></div>
          <p class="quiet-note">No commitment required to call the demo.</p>
        </div>
      </section>
    </main>

    <footer class="oj-footer">
      <div class="shell footer-inner">
        <div class="footer-brand"><a href="/" aria-label="OJ Solutions home"><span class="footer-mark">OJ</span> SOLUTIONS</a><p>Your AI front desk.</p><p>Built by business owners, for business owners.</p></div>
        <div><h2>CONTACT</h2><p>Kenosha, Wisconsin</p><a href={demoTel} data-track="demo_call_tap">{demoPhone}</a><p class="footer-pending">[BUSINESS EMAIL / DOMAIN – CONFIRM]</p></div>
        <div><h2>EXPLORE</h2><a href="#demo">Hear it live</a><a href="#how-it-works">How it works</a><a href="#pricing">Pricing</a><a href="#about">About</a><a href={booking} data-track="booking_tap">Book a call</a></div>
      </div>
      <div class="shell legal-line"><span>© {new Date().getFullYear()} OJ Solutions. All rights reserved.</span><span><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span><p>Calls with our AI assistant may be recorded. [LEGAL – REVIEW CALL RECORDING AND SMS DISCLOSURES]</p></div>
    </footer>
  </div>
  <script>
    const signal = (eventName: string) => {
      const w = window as typeof window & { dataLayer?: Array<Record<string, string>>; gtag?: (...args: unknown[]) => void };
      w.dataLayer?.push({ event: eventName });
      w.gtag?.("event", eventName);
    };
    document.querySelectorAll<HTMLAnchorElement>("a[data-track]").forEach((a) => {
      a.addEventListener("click", () => signal(a.dataset.track || "outbound_tap"));
    });
    document.querySelectorAll<HTMLAudioElement>("audio[data-track-audio]").forEach((audio) => {
      audio.addEventListener("play", () => signal("demo_audio_play"), { once: true });
    });
  </script>
  <style>
    .oj-landing { --ink:#0A0A0C; --bone:#F4F1EA; --gold:#C4A452; --steel:#8A93A0; --navy:#12203A; --green:#1FBF6B; --red:#E5484D; background:var(--ink); color:var(--bone); font-family:"Inter Tight","Inter",Arial,sans-serif; font-size:17px; line-height:1.55; overflow:hidden; }
    .oj-landing * { box-sizing:border-box; }
    .oj-landing h1,.oj-landing h2,.oj-landing h3,.oj-landing p { margin-top:0; }
    .oj-landing h1,.oj-landing h2,.oj-landing h3 { font-family:"Inter Tight","Inter",sans-serif; text-wrap:balance; }
    .oj-landing h1 em,.oj-landing h2 em { font-family:"Instrument Serif",Georgia,serif; font-weight:400; color:var(--gold); }
    .oj-landing a { color:inherit; text-decoration:none; }
    .oj-landing a:focus-visible,.oj-landing button:focus-visible,.oj-landing summary:focus-visible { outline:3px solid var(--gold); outline-offset:4px; }
    .oj-landing .shell { width:min(1200px,calc(100% - 40px)); margin-inline:auto; }
    .oj-landing .section-pad { padding:108px 0; }
    .oj-landing .eyebrow { display:flex; align-items:center; gap:12px; margin-bottom:30px; color:var(--gold); font:600 11px/1.5 "JetBrains Mono",monospace; letter-spacing:.13em; }
    .oj-landing .eyebrow-line { width:28px; height:1px; flex:0 0 28px; background:currentColor; }
    .oj-landing .ink-eyebrow { color:#80671e; }
    .oj-landing h2 { font-weight:850; letter-spacing:-.055em; font-size:clamp(37px,4.6vw,65px); line-height:1.07; }
    .oj-landing .site-header { position:sticky; top:0; z-index:50; background:#0A0A0CF2; border-bottom:1px solid #34302a; backdrop-filter:blur(12px); }
    .oj-landing .header-inner { min-height:82px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .oj-landing .brand { display:flex; align-items:center; gap:11px; flex-shrink:0; }
    .oj-landing .mark { background:var(--bone); display:flex; align-items:center; justify-content:center; border-radius:4px; width:47px; height:47px; overflow:hidden; }
    .oj-landing .mark img { width:39px; height:39px; object-fit:contain; }
    .oj-landing .brand-name { letter-spacing:.08em; font-size:16px; line-height:1.1; font-weight:500; white-space:nowrap; }
    .oj-landing .brand-name strong { font-weight:900; }
    .oj-landing .brand-name small { display:block; font:500 8px/1.5 "JetBrains Mono",monospace; letter-spacing:.16em; margin-top:4px; color:var(--steel); }
    .oj-landing .main-nav { display:flex; gap:30px; font-size:13px; font-weight:600; color:#cbc7c0; }
    .oj-landing .main-nav a:hover,.oj-landing .header-call:hover { color:var(--gold); }
    .oj-landing .header-actions { display:flex; align-items:center; gap:18px; }
    .oj-landing .header-call { font-size:13px; font-weight:700; white-space:nowrap; color:var(--gold); }
    .oj-landing .header-book { padding:12px 16px; border:1px solid var(--gold); border-radius:4px; color:var(--gold); font-size:13px; font-weight:700; white-space:nowrap; }
    .oj-landing .header-book:hover { background:var(--gold); color:var(--ink); }
    .oj-landing .hero { position:relative; background:radial-gradient(ellipse at 75% 40%,#191813 0%,#0A0A0C 62%); padding-bottom:38px; }
    .oj-landing .hero-layout { display:grid; grid-template-columns:minmax(0,1.12fr) minmax(330px,.88fr); align-items:center; gap:clamp(40px,6vw,100px); }
    .oj-landing .hero h1 { font-size:clamp(42px,5.1vw,77px); letter-spacing:-.062em; line-height:1.07; font-weight:900; margin-bottom:24px; }
    .oj-landing .hero h1 em { display:inline-block; }
    .oj-landing .hero-text { font-size:clamp(17px,1.5vw,20px); color:#b4b1aa; max-width:580px; line-height:1.65; }
    .oj-landing .button-row { display:flex; align-items:stretch; flex-wrap:wrap; gap:12px; margin-top:34px; }
    .oj-landing .btn { display:inline-flex; align-items:center; justify-content:center; gap:15px; padding:15px 20px; min-height:52px; font-size:14px; font-weight:800; border-radius:5px; transition:background-color .2s,color .2s,border-color .2s; text-align:center; }
    .oj-landing .btn span { font-size:19px; line-height:1; }

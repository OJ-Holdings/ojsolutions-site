---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import FinalCta from "../components/FinalCta.astro";
import CallDemo from "../components/home/CallDemo.astro";
import RecordedCall from "../components/demo/RecordedCall.astro";
import MissedCallProblem from "../components/home/MissedCallProblem.astro";
import ServiceTrio from "../components/home/ServiceTrio.astro";
import ProofSection from "../components/home/ProofSection.astro";
import SimplePricing from "../components/home/SimplePricing.astro";
import { BUSINESS_NAME, EMAIL, PHONE, SOCIAL_LINKS } from "../config";
import { SERVICES, bookingHref, filled } from "../lib/site";
import { HOME_FAQ } from "../lib/receptionist-offer";

const site = Astro.site ?? new URL("http://localhost:4321");
const organization = new URL("/#organization", site).href;
const areaServed = { "@type": "Country", name: "United States" };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": organization,
      name: BUSINESS_NAME,
      url: new URL("/", site).href,
      logo: new URL("/icon-512.png", site).href,
      ...(filled(EMAIL) && { email: EMAIL }),
      ...(filled(PHONE) && { telephone: PHONE }),
      areaServed,
      founder: [{ "@type": "Person", name: "Jacob Prahl" }, { "@type": "Person", name: "Oscar Johnston" }],
      ...(Object.values(SOCIAL_LINKS).some(filled) && { sameAs: Object.values(SOCIAL_LINKS).filter(filled) }),
    },
    ...SERVICES.map((s) => ({
      "@type": "Service",
      "@id": new URL(`${s.href}#service`, site).href,
      name: s.name,
      provider: { "@id": organization },
      areaServed,
      url: new URL(s.href, site).href,
    })),
    {
      "@type": "FAQPage",
      mainEntity: HOME_FAQ.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};

const steps = [
  { title: "We set up your front desk", body: "We configure the AI for your existing number, services, hours, and calendar." },
  { title: "It answers and books", body: "The AI identifies itself, captures the caller's request, and schedules an estimate." },
  { title: "You get the lead", body: "See who called, what they need, and when the estimate is booked." },
];


---

<BaseLayout
  title="OJ Solutions | AI Receptionists, Websites and Video Ads"
  description="An AI receptionist that answers and books your calls, websites that turn visitors into customers, and video ads made from your own clips. Call our live AI demo."
  jsonLd={jsonLd}
>
  <section class="on-navy overflow-hidden" aria-labelledby="hero-title">
    <div
      class="container-page grid gap-14 pt-12 pb-20 sm:pt-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-10 lg:pt-20 lg:pb-28"
    >
      <div>
        <p class="mb-5 text-sm font-bold tracking-widest text-gold uppercase">AI receptionists · Websites · Video ads</p>
        <h1 id="hero-title" class="display-1 max-w-[13ch] sm:max-w-none lg:max-w-[12ch]">
          You're on the job. <span class="mark-gold">Your phone still gets answered.</span>
        </h1>
        <p class="text-soft mt-6 max-w-xl text-lg sm:mt-8 sm:text-xl">
          An AI receptionist that answers your calls, captures the lead and books the estimate while you're doing the work.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href="tel:+12624010826" data-demo-call class="inline-flex min-h-14 items-center justify-center rounded-lg bg-gold px-6 text-base font-bold text-navy underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-navy sm:text-lg">Call our AI: (262) 401-0826</a>
          <a href={bookingHref()} data-book class="inline-flex min-h-14 items-center justify-center rounded-lg border border-gold px-6 text-base font-semibold text-white underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-gold sm:text-lg">Request a 15-min call</a>
        </div>
        <p class="text-soft mt-4 max-w-lg text-sm">It identifies itself as AI and walks through a pretend estimate request. Use a fake name and address. Calls may be recorded. <a href="/demo" class="font-semibold text-white underline decoration-gold underline-offset-4">What happens on the demo call?</a></p>
      </div>
      <div id="demo" class="scroll-mt-24"><CallDemo /></div>
    </div>
  </section>

  <RecordedCall />

  <MissedCallProblem />

  <ServiceTrio />

  <ProofSection />

  <section id="how-we-work" class="py-16 sm:py-24" aria-labelledby="how-title">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.4fr)] lg:gap-16">
      <h2 id="how-title" class="display-2">How the AI front desk works</h2>
      <div>
        <p class="how-statement font-heading text-[2.125rem] leading-[1.12] font-bold tracking-tight sm:text-5xl lg:text-[3.75rem]" aria-hidden="true" data-statement>
          {steps.map((step) => <><span class="clause">{step.title}.</span>{" "}</>)}
        </p>
        <ol role="list" class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-8">
          {
            steps.map((step, i) => (
              <li class="border-t-2 border-gold pt-5">
                <span class="font-heading text-lg font-bold" aria-hidden="true">{i + 1}</span>
                <h3 class="sr-only">Step {i + 1}: {step.title}</h3>
                <p class="mt-2 text-lg text-muted">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <SimplePricing />

  <FaqSection items={HOME_FAQ} title="Questions before you call" />

  <FinalCta
    heading="You do the work. We get the phone."
    line="Hear the live demo at (262) 401-0826, or book a quick call."
  />
</BaseLayout>

<style>
  /* Gold underline under each step. GSAP draws them in on scroll. */
  .clause {
    background: linear-gradient(var(--color-gold), var(--color-gold)) no-repeat 0 92% / 100% 0.09em;
    padding-bottom: 0.04em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .how-statement:global(.is-armed) .clause {
    background-size: 0% 0.09em;
  }
</style>

<script>
  // Homepage only: draw the gold underline under each step, one after
  // another, the first time "How we work" scrolls into view.
  const statement = document.querySelector<HTMLElement>("[data-statement]");
  if (statement && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    statement.classList.add("is-armed");
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        try {
          const { gsap } = await import("gsap");
          gsap.to(statement.querySelectorAll(".clause"), {
            backgroundSize: "100% 0.09em",
            duration: 1,
            ease: "expo.out",
            stagger: 0.5,
          });
        } catch {
          statement.classList.remove("is-armed");
        }
      },
      { threshold: 0.5 },
    );
    io.observe(statement);
  }
</script>

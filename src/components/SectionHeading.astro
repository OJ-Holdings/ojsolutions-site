---
// Section title + optional intro line. Works on white and navy sections.
interface Props {
  title: string;
  id?: string;
  intro?: string;
  tone?: "white" | "navy";
}

const { title, id, intro, tone = "white" } = Astro.props;
---

<div class="max-w-3xl">
  <h2 id={id} class="display-2">{title}</h2>
  {intro && <p class:list={["mt-5 max-w-2xl text-lg sm:text-xl", tone === "navy" ? "text-soft" : "text-muted"]}>{intro}</p>}
</div>

---
// "What's included": a ruled checklist, two columns on wide screens.
import Icon from "./Icon.astro";

interface Props {
  items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<ul role="list" class="mt-10 grid border-b border-line lg:grid-cols-2 lg:gap-x-12">
  {
    items.map((item) => (
      <li class="flex gap-4 border-t border-line py-6">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-navy text-gold" aria-hidden="true">
          <Icon name="check" class="size-[1.125rem]" />
        </span>
        <div>
          <h3 class="text-lg font-bold sm:text-xl">{item.title}</h3>
          <p class="mt-1.5 text-muted">{item.body}</p>
        </div>
      </li>
    ))
  }
</ul>

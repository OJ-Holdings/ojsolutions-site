---
// "What's included" grid. Simple cards, no tiers.
import Icon from "./Icon.astro";

interface Props {
  items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<ul role="list" class="mt-10 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
  {
    items.map((item) => (
      <li class="flex gap-3 rounded-lg border border-line p-5 sm:flex-col sm:gap-0 sm:p-6">
        <Icon name="check" class="mt-0.5 size-6 shrink-0 text-gold sm:mt-0" />
        <div>
          <h3 class="text-lg font-bold sm:mt-3">{item.title}</h3>
          <p class="mt-1.5 text-muted">{item.body}</p>
        </div>
      </li>
    ))
  }
</ul>

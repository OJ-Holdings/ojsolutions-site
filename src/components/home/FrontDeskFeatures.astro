---
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";

const features = [
  ["01", "24/7 answering", "Your AI receptionist can pick up while you're on the job, closed, or tied up with a customer."],
  ["02", "Lead capture", "It asks for the caller's name, address, service, and preferred timeframe."],
  ["03", "On-site estimate booking", "It schedules an available estimate on your connected calendar instead of guessing prices."],
  ["04", "Instant lead alerts", "You receive the information from the call without digging through voicemail."],
  ["05", "CRM and call history", "Keep the captured lead, recording, and transcript together for follow-up."],
  ["06", "Keep your business number", "Use it as overflow or as your primary front desk. You choose how calls are handled."],
];
const extras = [
  ["Missed-call recovery", "Reach back out when a caller doesn't get through."],
  ["CRM and pipeline", "Track leads from new inquiry to booked estimate and won or lost."],
  ["Online booking", "Give customers a way to pick an estimate slot."],
  ["Review requests", "Request honest Google reviews after a completed job."],
  ["Follow-up automation", "Send estimate follow-ups, appointment reminders, and customer reactivation messages."],
  ["Websites and forms", "Capture more requests from people visiting your website."],
  ["Reporting", "Review call volume, leads captured, and estimates booked."],
];
---
<Section id="front-desk" labelledby="front-desk-title">
  <SectionHeading id="front-desk-title" title="A front desk that works while you do" intro="No missed-call guessing game. Calls answered, details captured, estimates scheduled." />
  <div class="mt-12 grid gap-0 border-t border-line sm:grid-cols-2 lg:grid-cols-3">
    {features.map(([num, name, description]) => (
      <article class="border-b border-line px-1 py-7 sm:pr-8 lg:py-9">
        <span class="text-sm font-bold tracking-wider text-muted">{num}</span>
        <h3 class="mt-4 font-heading text-2xl font-bold tracking-tight">{name}</h3>
        <p class="mt-3 text-lg text-muted">{description}</p>
      </article>
    ))}
  </div>
</Section>
<Section id="more-tools" labelledby="more-tools-title" tone="navy" border>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-20">
    <div>
      <h2 id="more-tools-title" class="display-2">Everything behind the front desk.</h2>
      <p class="text-soft mt-6 max-w-lg text-lg">The receptionist is the first step. Add the follow-up systems your business needs as you grow.</p>
      <p class="text-soft mt-4 text-base">Additional modules are configured and scoped separately.</p>
    </div>
    <div class="rule-soft border-t">
      {extras.map(([name, description], i) => (
        <details class="rule-soft group border-b">
          <summary class="flex min-h-16 cursor-pointer items-center gap-4 py-4 text-left font-heading text-lg font-bold">
            <span class="text-sm text-gold">{String(i + 1).padStart(2, "0")}</span>
            <span class="flex-1">{name}</span>
            <span class="text-2xl text-gold group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="text-soft pb-5 pl-9">{description}</p>
        </details>
      ))}
    </div>
  </div>
</Section>

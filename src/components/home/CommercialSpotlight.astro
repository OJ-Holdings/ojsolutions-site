---
/**
 * The hero editorial video uses OJ Exterior Care's genuine existing work.
 * Upgrade to the founders' new v2 cut automatically when the correctly named
 * vetted binary and its matching poster are present in public/media/.
 * Never load a video above the fold or start it with sound.
 */
import { mediaAvailable } from "../../lib/media";
import BookButton from "../BookButton.astro";
const modernVideo = mediaAvailable("/media/OJ_Solutions_Commercial_v2_hero30.mp4")
  && mediaAvailable("/media/commercial-hero-poster.webp");
const video = modernVideo ? "/media/OJ_Solutions_Commercial_v2_hero30.mp4" : "/media/commercial-30.mp4";
const poster = modernVideo ? "/media/commercial-hero-poster.webp" : "/media/commercial-30-poster.webp";
const caption = mediaAvailable("/media/commercial-hero.vtt")
  ? "/media/commercial-hero.vtt"
  : mediaAvailable("/media/commercial-30.vtt") && !modernVideo ? "/media/commercial-30.vtt" : "";
---
<section id="commercial-showcase" class="on-navy border-y border-white/15" aria-labelledby="commercial-showcase-title">
  <div class="container-page grid gap-10 py-16 lg:grid-cols-[.95fr_1.05fr] lg:items-center lg:gap-20 lg:py-24">
    <div class="max-w-xl">
      <p class="text-xs font-extrabold uppercase tracking-[.17em] text-gold">Proof from our own business / OJ Exterior Care</p>
      <h2 id="commercial-showcase-title" class="display-2 mt-5">We built it for <span class="mark-gold">the work we actually do.</span></h2>
      <p class="text-soft mt-6 text-lg">Jacob Prahl and Oscar Johnston run OJ Exterior Care in southeast Wisconsin. This is footage we made for our own service business—real field work, not stock actors or made-up customer results.</p>
      <p class="text-soft mt-4">OJ Solutions combines that operator experience with AI call answering, lead capture, and a clearer way to follow up.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/about" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gold px-5 font-bold text-white hover:bg-gold hover:text-navy">Meet the founders <span aria-hidden="true" class="ml-2">↗</span></a>
        <BookButton variant="gold" size="lg" service="receptionist" label="Request 15 minutes" />
      </div>
    </div>

    <figure class="mx-auto w-full max-w-[32rem]">
      <div class="video-frame relative mx-auto aspect-[9/14] max-h-[34rem] overflow-hidden rounded-xl border border-white/25 bg-[#142842] shadow-2xl" data-featured-commercial>
        <video
          data-featured-video
          class="absolute inset-0 size-full object-cover"
          width="720"
          height="1280"
          poster={poster}
          muted
          loop
          playsinline
          preload="none"
          aria-label="OJ Exterior Care commercial: real exterior cleaning work"
        >
          <source src={video} type="video/mp4" />
          {caption && <track kind="captions" src={caption} srclang="en" label="English captions" />}
          Your browser does not support embedded video.
        </video>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-navy/90 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-0 bottom-4 flex flex-wrap items-center justify-between gap-3 px-4">
          <p class="max-w-[13rem] text-xs font-bold tracking-wide text-white">REAL WORK · OJ EXTERIOR CARE</p>
          <button type="button" data-play-sound class="inline-flex min-h-12 items-center justify-center rounded-lg bg-gold px-4 text-sm font-extrabold text-navy shadow-lg focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-white">
            <span aria-hidden="true" class="mr-2">▶</span>Play with sound
          </button>
        </div>
      </div>
      <figcaption class="text-soft mt-4 text-sm">A commercial created for our own exterior-care business. Muted preview when visible on desktop; sound only when you choose to play. <a href="/commercials" class="font-bold text-white underline decoration-gold underline-offset-4">Watch the full and short cuts</a>.</figcaption>
      <details class="text-soft mt-3 max-w-prose text-sm">
        <summary class="inline-flex min-h-11 cursor-pointer items-center font-bold text-white underline decoration-gold underline-offset-4">Read a description of the video</summary>
        <p class="mt-2">The commercial presents OJ Exterior Care's work and its operators. The footage represents the founders' own exterior-cleaning business, not testimonial footage from OJ Solutions customers. This is a summary, not a verbatim audio transcript.</p>
      </details>
    </figure>
  </div>
</section>
<script>
  const wrapper = document.querySelector<HTMLElement>("[data-featured-commercial]");
  const video = wrapper?.querySelector<HTMLVideoElement>("[data-featured-video]");
  const soundButton = wrapper?.querySelector<HTMLButtonElement>("[data-play-sound]");
  if (video && soundButton && wrapper) {
    let userStarted = false;
    const manual = () => {
      userStarted = true;
      video.muted = false;
      video.loop = false;
      video.controls = true;
      video.currentTime = 0;
      soundButton.hidden = true;
      video.play().catch(() => {
        soundButton.hidden = false;
        video.controls = true;
      });
    };
    soundButton.addEventListener("click", manual);
    // Save cellular bandwidth and avoid animation when motion is reduced.
    const canPreview = window.matchMedia("(min-width: 768px)").matches
      && !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      && !(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData
      && "IntersectionObserver" in window;
    if (canPreview) {
      const observer = new IntersectionObserver((entries) => {
        if (userStarted) return;
        if (entries.some(entry => entry.isIntersecting)) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      }, { threshold: 0.25 });
      observer.observe(wrapper);
    }
  }
</script>
<style>
  [data-play-sound][hidden] { display: none; }
  .video-frame video { object-position: center; }
  @media (prefers-reduced-motion: reduce) {
    .video-frame * { transition: none !important; }
  }
</style>

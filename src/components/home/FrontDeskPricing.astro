---
// The one AI Receptionist plan, shown on /ai-receptionist.
// Every number and the included list come from src/data/pricing.ts.
import Section from "../Section.astro";
import BookButton from "../BookButton.astro";
import Icon from "../Icon.astro";
import { PRICING, money } from "../../data/pricing";

const { monthly, setup, includes } = PRICING.receptionist;
---

<Section id="pricing" labelledby="pricing-title">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] lg:gap-16">
    <div>
      <p class="mb-4 text-sm font-bold tracking-widest text-muted uppercase">Pricing</p>
      <h2 id="pricing-title" class="display-2">One plan. Everything included.</h2>
      <p class="mt-6 font-heading text-6xl font-bold tracking-tight sm:text-7xl">
        {money(monthly)}<span class="ml-2 font-sans text-lg font-normal tracking-normal text-muted">/month</span>
      </p>
      <p class="mt-3 text-xl text-muted">+ {money(setup)} one-time setup</p>
      <div class="mt-8">
        <BookButton service="receptionist" size="lg" />
      </div>
    </div>
    <div>
      <h3 class="text-sm font-bold tracking-widest text-muted uppercase">What you get</h3>
      <ul role="list" class="mt-5 border-b border-line">
        {
          includes.map((item) => (
            <li class="flex gap-4 border-t border-line py-4">
              <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md bg-navy text-gold" aria-hidden="true">
                <Icon name="check" class="size-4" />
              </span>
              <span class="text-lg">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

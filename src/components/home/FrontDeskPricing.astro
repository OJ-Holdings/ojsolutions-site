---
import Section from "../Section.astro";
import BookButton from "../BookButton.astro";
import { RECEPTIONIST_PRICING, RECEPTIONIST_TERMS_NOTICE } from "../../lib/receptionist-pricing";
const money = (v: number) => new Intl.NumberFormat("en-US", {style:"currency",currency:"USD",maximumFractionDigits:0}).format(v);
---
<Section id="pricing" labelledby="pricing-title">
  <div class="max-w-3xl">
    <p class="mb-4 text-sm font-bold tracking-widest text-muted uppercase">Straightforward pricing</p>
    <h2 id="pricing-title" class="display-2">A front desk that fits the way you work.</h2>
    <p class="mt-5 text-lg text-muted">Start with answering calls. Add scheduling and follow-up when you're ready. Both plans are configured to your business.</p>
  </div>
  <div class="mt-10 grid gap-5 md:grid-cols-2 md:gap-6">
    {RECEPTIONIST_PRICING.plans.map(plan => (
      <article class:list={["relative flex flex-col rounded-xl border p-6 sm:p-8", plan.featured ? "border-gold bg-navy text-white shadow-xl" : "border-line bg-white text-navy"]}>
        {plan.featured && <p class="mb-4 inline-flex self-start rounded-full bg-gold px-3 py-1 text-xs font-extrabold text-navy">MORE AUTOMATION</p>}
        <h3 class="font-heading text-2xl font-bold">{plan.title}</h3>
        <p class:list={["mt-2 text-base",plan.featured ? "text-soft" : "text-muted"]}>{plan.tagline}</p>
        <p class="mt-6 font-heading text-5xl font-bold tracking-tight">{money(plan.price)}<span class:list={["ml-2 font-sans text-base font-normal",plan.featured?"text-soft":"text-muted"]}>/month</span></p>
        <p class:list={["mt-3",plan.featured?"text-soft":"text-muted"]}>{plan.summary}</p>
        <ul class:list={["mt-7 flex-1 space-y-4 border-t pt-6",plan.featured?"border-white/30":"border-line"]}>
          {plan.features.map(feature => (
            <li class="flex gap-3 text-base"><span class:list={["shrink-0 font-bold",plan.featured?"text-gold":"text-navy"]} aria-hidden="true">✓</span><span>{feature}</span></li>
          ))}
        </ul>
        <div class="mt-8"><BookButton service="receptionist" size="lg" variant={plan.featured?"gold":"navy"} label={"Request "+plan.title+" consultation"} class="w-full" /></div>
      </article>
    ))}
  </div>
  <div class="mt-7 rounded-xl border border-line bg-white p-5 sm:p-7">
    <p class="text-lg font-bold">{RECEPTIONIST_PRICING.setup.note}</p>
    <p class="mt-2 text-muted">{RECEPTIONIST_TERMS_NOTICE}</p>
    <p class="mt-3 text-sm text-muted">The booking page takes your preferred time and contact details. Your consultation isn't confirmed until our team follows up.</p>
  </div>
</Section>

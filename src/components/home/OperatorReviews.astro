---
/* These reviews concern OJ EXTERIOR CARE, the founders' separate field-service company.
   Never present these as AI receptionist customer outcomes. */
import { EXTERIOR_CARE_REVIEWS as reviews } from "../../data/reviews";
---
<section class="border-y border-line bg-white" aria-labelledby="operator-reviews">
  <div class="container-page py-14 sm:py-20">
    <div class="grid gap-7 lg:grid-cols-[.8fr_1.2fr] lg:items-start lg:gap-14">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-widest text-muted">From our own service business</p>
        <h2 id="operator-reviews" class="display-2 mt-4">Real customers. Real work.</h2>
        <p class="mt-5 text-lg text-muted">Google reviews of <strong>OJ Exterior Care</strong>, the exterior cleaning company Jacob Prahl and Oscar Johnston run.</p>
        <p class="mt-6 font-heading text-3xl font-bold text-navy">{reviews.rating} <span aria-label="five out of five stars" class="text-gold">★★★★★</span></p>
        <p class="mt-2 text-sm text-muted">{reviews.count} Google reviews of OJ Exterior Care</p>
        <a href={reviews.url} rel="noopener noreferrer" target="_blank" class="mt-5 inline-flex min-h-12 items-center font-bold text-navy underline decoration-gold underline-offset-4">Read OJ Exterior Care reviews <span aria-hidden="true" class="ml-2">↗</span><span class="sr-only">(opens in new tab)</span></a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {reviews.quotes.map((review, i) => (
          <figure class:list={["rounded-lg border border-line p-5 sm:p-7",i===0?"sm:col-span-2":""]}>
            <p class="text-gold" aria-label="Five stars">★★★★★</p>
            <blockquote class="mt-3 text-lg font-medium leading-relaxed text-navy">“{review.quote}”</blockquote>
            <figcaption class="mt-5 text-sm text-muted">{review.author} · Google review of OJ Exterior Care</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

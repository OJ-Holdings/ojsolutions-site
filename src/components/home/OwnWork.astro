---
// "We run businesses too": our own story, before/after photos from our own
// pressure washing company (never client results), and our own commercial
// as a muted loop.
import { Image } from "astro:assets";
import houseBefore from "../../assets/photos/exterior-house-wash-before.jpg";
import houseAfter from "../../assets/photos/exterior-house-wash-after.jpg";
import stepsBefore from "../../assets/photos/exterior-steps-before.jpg";
import stepsAfter from "../../assets/photos/exterior-steps-after.jpg";
import siding from "../../assets/photos/exterior-siding-before-after.jpg";

// Each before/after pair keeps the photo's real proportions side by side.
const pairs = [
  {
    caption: "House wash: siding and front entry",
    before: { src: houseBefore, alt: "Before the house wash: gray siding and the front entry" },
    after: { src: houseAfter, alt: "After the house wash: the same siding and front entry, clean" },
    // The difference is faint at phone width, so these stack on phones.
    stackOnPhones: true,
  },
  {
    caption: "Concrete front steps",
    before: { src: stepsBefore, alt: "Before: dirty concrete front steps with white railings" },
    after: { src: stepsAfter, alt: "After: the same concrete front steps, clean" },
    stackOnPhones: false,
  },
];
---

<section id="why-us" class="on-navy rule-soft border-t" aria-labelledby="why-title">
  <div class="container-page py-16 sm:py-24">
    <div class="own-work grid gap-x-12 gap-y-12 lg:gap-x-16">
      <div class="area-copy">
        <h2 id="why-title" class="display-2">We run businesses too</h2>
        <div class="text-soft mt-6 max-w-xl space-y-4 text-lg">
          <p>
            We're Jacob and Oscar. Besides OJ Solutions, we run our own businesses, including a pressure washing and
            window cleaning company.
          </p>
          <p>
            Everything we sell, we built for our own business first and tested it there before offering it to anyone
            else. So when we talk about missed calls, websites, and getting seen online, we're talking about problems we
            deal with ourselves.
          </p>
        </div>
      </div>

      <div class="area-photos">
        <p class="font-heading text-lg font-bold text-balance">
          From OJ Exterior Care, our own pressure washing and window cleaning company.
        </p>
        <ul role="list" class="mt-6 space-y-10">
          {
            pairs.map((pair) => (
              <li>
                <figure>
                  <div
                    class="pair grid gap-2"
                    data-stack={pair.stackOnPhones ? "" : undefined}
                    style={`--before:${pair.before.src.width}fr;--after:${pair.after.src.width}fr`}
                  >
                    {[
                      { label: "Before", img: pair.before },
                      { label: "After", img: pair.after },
                    ].map(({ label, img }) => (
                      <div class="relative overflow-hidden rounded-md">
                        <Image
                          src={img.src}
                          alt={img.alt}
                          widths={[360, 560, 800, img.src.width]}
                          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                          class="block h-auto w-full"
                        />
                        <span class="absolute top-2 left-2 rounded-sm bg-navy px-2 py-0.5 text-xs font-semibold tracking-wide text-white uppercase">
                          {label}
                        </span>
                      </div>
                    ))}
                  </div>
                  <figcaption class="text-soft mt-3">{pair.caption}</figcaption>
                </figure>
              </li>
            ))
          }
          <li>
            <figure>
              <Image
                src={siding}
                alt="Before and after: gray vinyl siding on a gable wall with green algae, then clean"
                widths={[360, 560, 800, 1200]}
                sizes="(min-width: 1024px) 55vw, 92vw"
                class="block h-auto w-full rounded-md"
              />
              <figcaption class="text-soft mt-3">Siding with algae on a gable wall</figcaption>
            </figure>
          </li>
        </ul>
      </div>

      <figure class="area-video" data-loop>
        <div class="rule-soft relative mx-auto aspect-[9/16] w-full max-w-[17.5rem] overflow-hidden rounded-lg border lg:mx-0">
          <video
            class="block size-full object-cover"
            muted
            loop
            playsinline
            preload="none"
            width="540"
            height="960"
            poster="/media/commercial-loop-poster.webp"
            aria-label="Clip from our own commercial, playing without sound"
          >
            <source src="/media/commercial-loop.mp4" type="video/mp4" />
          </video>
          <button
            type="button"
            data-loop-toggle
            hidden
            aria-pressed="false"
            class="absolute right-2 bottom-2 inline-flex size-11 items-center justify-center rounded-md bg-navy text-white hover:text-gold"
          >
            <svg class="loop-pause size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg
            >
            <svg class="loop-play hidden size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d="M8 5.5v13l11-6.5z"></path></svg
            >
            <span class="sr-only" data-loop-label>Pause the clip</span>
          </button>
        </div>
        <figcaption class="mx-auto mt-4 max-w-[17.5rem] lg:mx-0">
          <span class="block font-semibold">Our own commercial.</span>
          <a href="/commercials" class="link mt-1 inline-flex min-h-11 items-center">Watch it with sound</a>
        </figcaption>
      </figure>

      <p class="area-close text-soft max-w-3xl text-lg sm:text-xl">
        We're a for-profit company and we're upfront about that. But the real reason we do this is that we firmly
        believe a lot of businesses are missing out on what AI can do to improve every part of how they run, and we want
        to help change that.
      </p>
    </div>
  </div>
</section>

<style>
  .own-work {
    grid-template-areas: "copy" "photos" "video" "close";
  }
  @media (min-width: 1024px) {
    .own-work {
      grid-template-columns: 5fr 7fr;
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "copy photos" "video photos" "close close";
    }
  }
  .area-copy {
    grid-area: copy;
  }
  .area-photos {
    grid-area: photos;
  }
  .area-video {
    grid-area: video;
  }
  .area-close {
    grid-area: close;
  }
  .pair {
    grid-template-columns: var(--before) var(--after);
  }
  @media (max-width: 639.98px) {
    .pair[data-stack] {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Our commercial loops muted while it's on screen. Reduced motion: it
  // stays on the poster and gets regular controls instead.
  const figure = document.querySelector<HTMLElement>("[data-loop]");
  const video = figure?.querySelector("video");
  const toggle = figure?.querySelector<HTMLButtonElement>("[data-loop-toggle]");
  if (figure && video && toggle) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduce.matches) {
      video.controls = true;
      video.removeAttribute("aria-label");
    } else {
      let userPaused = false;
      let onScreen = false;
      const sync = () => {
        if (onScreen && !userPaused) video.play().catch(() => {});
        else video.pause();
      };
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        userPaused = !userPaused;
        toggle.setAttribute("aria-pressed", String(userPaused));
        toggle.querySelector(".loop-pause")!.classList.toggle("hidden", userPaused);
        toggle.querySelector(".loop-play")!.classList.toggle("hidden", !userPaused);
        toggle.querySelector("[data-loop-label]")!.textContent = userPaused ? "Play the clip" : "Pause the clip";
        sync();
      });
      new IntersectionObserver(
        (entries) => {
          onScreen = entries.some((e) => e.isIntersecting);
          sync();
        },
        { threshold: 0.25 },
      ).observe(video);
    }
  }
</script>

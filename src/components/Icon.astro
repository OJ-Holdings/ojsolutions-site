const isStroke = name in stroke;
const body = isStroke ? stroke[name] : fill[name];
---

{
  isStroke ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={body}
    />
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      set:html={body}
    />
  )
}

---
// Top of every service page: a navy band with the service name, headline,
// subhead, and the Book a call button. An optional "aside" slot puts proof
// (a player, a video, a screenshot) beside the copy on wide screens and
// right under the button on phones.
import BookButton from "./BookButton.astro";
import CallButton from "./CallButton.astro";
import Icon from "./Icon.astro";
import type { ServiceKey } from "../lib/site";

interface Props {
  title: string;
  /** Part of the title to underline in gold. Keep it short: it never wraps. */
  highlight?: string;
  subhead: string;
  /** The service name, shown with its icon above the headline. */
  eyebrow?: string;
  service?: ServiceKey;
  /** Lead with the live AI demo line; Book a call becomes the outlined secondary. */
  callFirst?: boolean;
}

const { title, highlight, subhead, eyebrow, service, callFirst = false } = Astro.props;
const at = highlight ? title.lastIndexOf(highlight) : -1;
const before = at >= 0 ? title.slice(0, at) : title;
const marked = at >= 0 ? highlight : "";
const after = at >= 0 ? title.slice(at + (highlight?.length ?? 0)) : "";
const icon = ({ receptionist: "phone", website: "browser", commercial: "camera" } as const)[service ?? "receptionist"];
const hasAside = Astro.slots.has("aside");
---

<section class="on-navy overflow-hidden" aria-labelledby="page-title">
  <div
    class:list={[
      "container-page grid gap-12 pt-9 pb-16 sm:pt-16 sm:pb-24",
      hasAside && "lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-14",
    ]}
  >
    <div class="max-w-3xl">
      {
        eyebrow && (
          <p class="flex items-center gap-2.5 font-heading text-base font-bold">
            <span class="flex size-8 items-center justify-center rounded-md bg-gold text-navy" aria-hidden="true">
              <Icon name={icon} class="size-[1.125rem]" />
            </span>
            {eyebrow}
          </p>
        )
      }
      <h1 id="page-title" class:list={["display-1", eyebrow && "mt-5 sm:mt-7"]}>
        {before}{marked && <span class="mark-gold whitespace-nowrap">{marked}</span>}{after}
      </h1>
      <p class="text-soft mt-5 max-w-2xl text-lg sm:mt-7 sm:text-xl">{subhead}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 sm:mt-9">
        {callFirst && <CallButton />}
        <BookButton service={service} variant={callFirst ? "outline" : "gold"} size="lg" />
        <slot name="secondary" />
      </div>
      <slot name="note" />
    </div>
    {hasAside && <div><slot name="aside" /></div>}
  </div>
</section>

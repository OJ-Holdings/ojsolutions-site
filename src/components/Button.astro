---
// Brand button.
// variant "navy": navy with white text, for white sections.
// variant "gold": gold with navy text, for navy sections.
// variant "outline": gold outline with white text, a secondary button on navy.
// variant "outline-navy": navy outline with navy text, a secondary button on white.
interface Props {
  href: string;
  variant?: "navy" | "gold" | "outline" | "outline-navy";
  size?: "header" | "sm" | "md" | "lg";
  class?: string;
  [key: string]: unknown;
}

const { href, variant = "navy", size = "md", class: className = "", ...rest } = Astro.props;

const variants = {
  navy: "bg-navy text-white hover:decoration-gold",
  gold: "bg-gold text-navy hover:decoration-navy",
  outline: "border border-gold text-white hover:decoration-gold",
  "outline-navy": "border border-navy text-navy hover:decoration-gold",
};
const sizes = {
  // Header button: tighter on narrow phones so the header fits at 320px.
  header: "min-h-11 px-2.5 text-[0.875rem] min-[400px]:px-4 min-[400px]:text-[0.9375rem]",
  sm:"min-h-11 px-4 text-[0.9375rem]",
  md: "min-h-12 px-6 text-base",
  lg: "min-h-14 px-7 text-lg",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-lg font-semibold whitespace-nowrap",
    "decoration-transparent decoration-2 underline-offset-4 underline transition-colors",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>

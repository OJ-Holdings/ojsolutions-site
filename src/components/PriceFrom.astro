---
// "Starting at $X" when a price is set, otherwise "we quote after a call".
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
import { filled, formatPrice } from "../lib/site";

interface Props {
  price: number | null;
  /** What gets quoted, e.g. "site" or "project" */
  noun: string;
}

const { price, noun } = Astro.props;
const hasPrice = filled(price);
---

<Section id="pricing" labelledby="pricing-title" border={false}>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
    <SectionHeading id="pricing-title" title="Pricing" />
    <div class="border-t-2 border-gold pt-6">
      {
        hasPrice ? (
          <>
            <p class="text-muted">Starting at</p>
            <p class="mt-1 font-heading text-5xl font-bold tracking-tight sm:text-6xl">{formatPrice(price as number)}</p>
            <p class="mt-4 max-w-xl text-lg text-muted">
              The exact price depends on what your {noun} needs. We'll give you a number after a quick call.
            </p>
          </>
        ) : (
          <p class="max-w-2xl font-heading text-2xl leading-snug font-medium sm:text-3xl">
            Every {noun} is different, so we quote after a quick call.
          </p>
        )
      }
    </div>
  </div>
</Section>

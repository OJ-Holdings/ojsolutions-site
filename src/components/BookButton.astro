---
// The one conversion on every page. It always goes to /book
// (bookingHref in src/lib/site.ts), tagged with the service on service pages.
import Button from "./Button.astro";
import { bookingHref, type ServiceKey } from "../lib/site";

interface Props {
  service?: ServiceKey;
  variant?: "navy" | "gold" | "outline" | "outline-navy";
  size?: "header" | "sm" | "md" | "lg";
  label?: string;
  class?: string;
}

const { service, variant = "navy", size = "md", label = "Request a call", class: className } = Astro.props;
const href = bookingHref(service);
---

<Button href={href} variant={variant} size={size} class={className} data-book>
  {label}
</Button>

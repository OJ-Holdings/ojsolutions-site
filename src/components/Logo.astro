---
// The OJ mark (image) plus "OJ Solutions" as live text.
// The mark has a navy design, so it only ever sits on white. On navy
// (tone="navy") it sits on a small white tile, like the share image.
import { Image } from "astro:assets";
import mark from "../assets/brand/oj-mark.png";
import { BUSINESS_NAME } from "../config";

interface Props {
  /** "header" shrinks on narrow phones so the header fits at 320px. */
  size?: "header" | "default";
  tone?: "white" | "navy";
  class?: string;
}

const { size = "default", tone = "white", class: className = "" } = Astro.props;
const onNavy = tone === "navy";
// "OJ Solutions" -> "OJ" bold, "Solutions" medium
const [first, ...restWords] = BUSINESS_NAME.split(" ");

const sizes = {
  header: {
    link: "gap-1.5 min-[400px]:gap-2.5",
    img: "h-[22px] min-[360px]:h-[24px] min-[400px]:h-[28px] sm:h-[30px]",
    text: "text-[0.875rem] min-[360px]:text-[0.9375rem] min-[400px]:text-[1.0625rem] sm:text-[1.1875rem]",
  },
  default: { link: "gap-2.5", img: "h-[30px]", text: "text-[1.1875rem]" },
}[size];
---

<a href="/" aria-label="OJ Solutions homepage" class:list={["inline-flex min-h-11 shrink-0 items-center rounded-sm", sizes.link, className]}>
  {
    onNavy ? (
      <span class="inline-flex shrink-0 rounded-md bg-white p-1">
        <Image src={mark} alt="" height={34} densities={[1, 2]} loading="eager" class:list={["w-auto", sizes.img]} />
      </span>
    ) : (
      <Image src={mark} alt="" height={34} densities={[1, 2]} loading="eager" class:list={["w-auto", sizes.img]} />
    )
  }
  <span
    class:list={[
      "font-heading leading-none tracking-tight whitespace-nowrap",
      onNavy ? "text-white" : "text-navy",
      sizes.text,
    ]}
  >
    <span class="font-bold">{first}</span>
    {restWords.length > 0 && (
      <span class={size === "header" ? "hidden min-[380px]:inline" : ""}>{" "}<span class="font-medium">{restWords.join(" ")}</span></span>
    )}
  </span>
</a>

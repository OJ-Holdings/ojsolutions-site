---
// A flat phone: a lighter navy bezel with a 1px border and a screenshot
// inside. Sits on navy. The bezel is opaque so it can overlap other mockups.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  class?: string;
}

const { src, alt, widths = [200, 400, 600], sizes, loading = "lazy", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative rounded-lg border border-white/30 bg-[color-mix(in_srgb,var(--color-white)_9%,var(--color-navy))] px-2 pt-5 pb-2",
    className,
  ]}
>
  <span class="absolute top-2 left-1/2 h-1 w-9 -translate-x-1/2 rounded-sm bg-white/30" aria-hidden="true"></span>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={80}
    loading={loading}
    class="block h-auto w-full rounded-sm"
  />
</div>

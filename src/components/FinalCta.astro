---
// Full-width navy close at the bottom of each main page.
import BookButton from "./BookButton.astro";
import CallButton from "./CallButton.astro";
import type { ServiceKey } from "../lib/site";

interface Props {
  heading: string;
  line?: string;
  service?: ServiceKey;
  /** Lead with the live AI demo line; Book a call becomes the outlined secondary. */
  callFirst?: boolean;
}

const { heading, line, service, callFirst = false } = Astro.props;
---

{
  (
    <section class="on-navy rule-soft border-t" aria-labelledby="final-cta">
      <div class="container-page py-20 sm:py-28">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-16">
          <div class="max-w-3xl">
            <h2 id="final-cta" class="display-1">{heading}</h2>
            {line && <p class="text-soft mt-6 max-w-xl text-lg sm:text-xl">{line}</p>}
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            {callFirst && <CallButton />}
            <BookButton variant={callFirst ? "outline" : "gold"} size="lg" service={service} />
          </div>
        </div>
      </div>
    </section>
  )
}

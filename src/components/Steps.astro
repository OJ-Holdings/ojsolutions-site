---
// Numbered "how it works" steps on a track: down the left on phones,
// across the top on wide screens. Works on white and navy sections.
interface Props {
  steps: { title: string; body: string }[];
  tone?: "white" | "navy";
}

const { steps, tone = "white" } = Astro.props;
const navy = tone === "navy";
---

<ol role="list" class="steps mt-12 grid gap-0 md:grid-cols-3 md:gap-8">
  {
    steps.map((step, i) => (
      <li class="relative grid grid-cols-[2.5rem_1fr] gap-x-5 pb-10 last:pb-0 md:block md:pb-0">
        <span
          class:list={[
            "track absolute top-10 bottom-0 left-5 w-px md:top-5 md:right-[-2rem] md:bottom-auto md:left-10 md:h-px md:w-auto",
            navy ? "bg-white/20" : "bg-line",
          ]}
          aria-hidden="true"
        />
        <span
          class:list={[
            "relative flex size-10 items-center justify-center rounded-md font-heading text-lg font-bold",
            navy ? "bg-gold text-navy" : "bg-navy text-white",
          ]}
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div class="md:mt-6">
          <h3 class="text-xl font-bold sm:text-2xl">
            <span class="sr-only">Step {i + 1}: </span>
            {step.title}
          </h3>
          <p class:list={["mt-2 text-lg", navy ? "text-soft" : "text-muted"]}>{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps > li:last-child .track {
    display: none;
  }
</style>

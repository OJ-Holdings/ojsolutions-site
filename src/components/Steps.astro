---
// Numbered "how it works" steps.
interface Props {
  steps: { title: string; body: string }[];
}

const { steps } = Astro.props;
---

<ol role="list" class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6">
  {
    steps.map((step, i) => (
      <li class="flex gap-4 md:flex-col md:rounded-lg md:border md:border-line md:p-6">
        <span
          class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-navy font-heading text-lg font-bold text-white"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div>
          <h3 class="text-xl font-bold">
            <span class="sr-only">Step {i + 1}: </span>
            {step.title}
          </h3>
          <p class="mt-2 text-muted">{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>

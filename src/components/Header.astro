---
import Logo from "./Logo.astro";
import BookButton from "./BookButton.astro";
import Icon from "./Icon.astro";
import { SERVICES, type ServiceKey } from "../lib/site";

interface Props {
  /** Hide the header button (used on /book, where it would link to itself). */
  hideBookButton?: boolean;
  /** On service pages the header button is tagged with the service too. */
  service?: ServiceKey;
}

const { hideBookButton = false, service } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
---

<header class="on-navy rule-soft sticky top-0 z-40 border-b">
  <div class="container-page relative flex h-16 items-center justify-between gap-1 min-[340px]:gap-2 md:static">
    <Logo size="header" tone="navy" />
    <div class="flex items-center gap-0.5 min-[400px]:gap-1 sm:gap-3">
      <nav aria-label="Main">
        <details class="group md:relative" data-menu>
          <summary
            class="flex min-h-11 items-center gap-0.5 rounded-lg px-1 text-[0.875rem] font-semibold whitespace-nowrap text-white hover:underline hover:decoration-gold hover:decoration-2 hover:underline-offset-4 min-[340px]:px-1.5 min-[400px]:gap-1 min-[400px]:px-2 min-[400px]:text-[0.9375rem] sm:px-3"
          >
            Services
            <Icon name="chevron-down" class="hidden size-3.5 transition-transform group-open:rotate-180 min-[360px]:block min-[400px]:size-4" />
          </summary>
          <ul
            class="rule-soft absolute inset-x-0 top-full border-b bg-navy px-4 pb-3 sm:px-6 md:inset-x-auto md:right-0 md:mt-4 md:w-72 md:rounded-lg md:border md:p-2"
          >
            <li><a href="/services" class="flex min-h-12 items-center py-2 font-bold text-gold hover:underline md:px-3">All services</a></li>
            {
              SERVICES.map((s) => (
                <li class="rule-soft border-t first:border-t-0 md:border-t-0">
                  <a
                    href={s.href}
                    aria-current={path === s.href ? "page" : undefined}
                    class="flex min-h-12 items-center justify-between gap-3 py-2 font-semibold text-white hover:underline hover:decoration-gold hover:decoration-2 hover:underline-offset-4 aria-[current=page]:underline aria-[current=page]:decoration-gold aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-4 md:rounded-md md:px-3"
                  >
                    {s.name}
                    <Icon name="arrow-right" class="size-4 text-gold" />
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
      <a href="tel:+12624010826"
        class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-lg border border-gold px-2 text-gold hover:bg-gold hover:text-navy sm:px-3"
        aria-label="Call the OJ Solutions AI demo at (262) 401-0826" title="Call our AI demo">
        <Icon name="phone" class="size-5 shrink-0" />
        <span class="hidden font-semibold lg:inline">Call (262) 401-0826</span>
      </a>
      {!hideBookButton && <>
        <BookButton size="header" variant="gold" service={service} label="Request" class="min-[480px]:hidden" />
        <BookButton size="header" variant="gold" service={service} label="Request 15 min" class="hidden min-[480px]:inline-flex" />
      </>}
    </div>
  </div>
</header>

<script is:inline>
  // Close the Services menu on outside click, when focus leaves it, or Escape.
  (() => {
    const menu = document.querySelector("details[data-menu]");
    if (!menu) return;
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target)) menu.open = false;
    });
    menu.addEventListener("focusout", (e) => {
      if (menu.open && e.relatedTarget && !menu.contains(e.relatedTarget)) menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        const hadFocus = menu.contains(document.activeElement);
        menu.open = false;
        if (hadFocus) menu.querySelector("summary").focus();
      }
    });
  })();
</script>

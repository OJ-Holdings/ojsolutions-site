---
// Every page uses this: <head> tags for SEO and sharing, the header,
// the footer, and the GHL chat widget (when set in src/config.ts).
import "@fontsource/inter-tight/latin-500.css";
import "@fontsource/inter-tight/latin-700.css";
import "@fontsource/inter-tight/latin-800.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import "../styles/global.css";
import interTight700 from "@fontsource/inter-tight/files/inter-tight-latin-700-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BUSINESS_NAME, GHL_CHAT_WIDGET } from "../config";
import { filled, type ServiceKey } from "../lib/site";

interface Props {
  /** Unique page title, shown in the browser tab and search results. */
  title: string;
  /** Unique description for search results and link previews. */
  description: string;
  /** Keep this page out of search results (404 page). */
  noindex?: boolean;
  /** Hide the header "Book a call" button. */
  hideBookButton?: boolean;
  /** Extra structured data for search engines. */
  jsonLd?: Record<string, unknown>;
  /** Service pages tag the header Book a call button with their service. */
  service?: ServiceKey;
}

const { title, description, noindex = false, hideBookButton = false, jsonLd, service } = Astro.props;

const site = Astro.site ?? new URL("http://localhost:4321");
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/(.)\/$/, "$1").replace(/\/index$/, "/");
const canonical = new URL(path, site).href;
const ogImage = new URL("/og-image.png", site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={interTight700} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B1F3A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OJ Solutions AI front desk for home-service businesses." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-navy px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-4 focus:py-3"
    >
      Skip to content
    </a>
    <Header hideBookButton={hideBookButton} service={service} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Outreach links carry tags like ?src=ig&rep=jacob&utm_source=facebook.
      // Remember them for this visit and add them to consultation-request
      // links without exposing contact details in analytics.
      (() => {
        const KEY = "oj-tracking";
        const keep = (k) => k === "src" || k === "rep" || k.startsWith("utm_");
        let tags = {};
        try {
          tags = JSON.parse(sessionStorage.getItem(KEY) || "{}");
        } catch {}
        new URLSearchParams(location.search).forEach((v, k) => {
          if (keep(k) && v) tags[k] = v;
        });
        try {
          sessionStorage.setItem(KEY, JSON.stringify(tags));
        } catch {}
        if (!Object.keys(tags).length) return;
        document.querySelectorAll("a[data-book]").forEach((a) => {
          const url = new URL(a.href, location.href);
          for (const [k, v] of Object.entries(tags)) if (!url.searchParams.has(k)) url.searchParams.set(k, v);
          a.href = url.href;
        });
      })();
    </script>
    <script is:inline>
      // Privacy-first event hooks. No tracking vendor is loaded until configured.
      // Only static event types and page/section labels are sent. Never emit
      // names, contact details, selected slots, transcript text, or query values.
      (() => {
        const allowedEvents = new Set([
          "demo_call_tap", "book_request_submit", "demo_audio_play",
          "demo_audio_complete", "commercial_play", "pricing_view",
          "faq_open", "trade_page_view", "consultation_booking_click"
        ]);
        const safeLabel = value => {
          const label = String(value || "other").toLowerCase().replace(/[^a-z0-9_-]/g, "").slice(0, 40);
          return label || "other";
        };
        const emit = (event, properties = {}) => {
          if (!allowedEvents.has(event)) return;
          const payload = {};
          for (const key of ["location", "trade", "service"]) {
            if (Object.prototype.hasOwnProperty.call(properties, key)) payload[key] = safeLabel(properties[key]);
          }
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event, ...payload });
          if (typeof window.gtag === "function") window.gtag("event", event, payload);
        };
        window.ojTrack = emit;
        const locationFor = element => {
          const explicit = element.closest("[data-track-location]")?.getAttribute("data-track-location");
          if (explicit) return safeLabel(explicit);
          if (element.closest("header")) return "header";
          if (element.closest("footer")) return "footer";
          if (element.closest("#commercial-showcase")) return "commercial_showcase";
          if (element.closest("#pricing")) return "pricing";
          if (element.closest("#recorded-call")) return "recorded_demo";
          if (element.closest("#demo")) return "hero_demo";
          if (element.closest("main > section:first-child")) return "hero";
          return "page";
        };
        document.addEventListener("click", e => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          const anchor = target.closest("a");
          if (anchor && anchor.getAttribute("href")?.startsWith("tel:"))
            emit("demo_call_tap", { location: locationFor(anchor) });
          if (anchor && anchor.hasAttribute("data-book"))
            emit("consultation_booking_click", { location: locationFor(anchor) });
          const summary = target.closest("#faq details > summary");
          if (summary && !summary.parentElement.open)
            emit("faq_open", { location: "faq" });
        });
        document.addEventListener("play", e => {
          const media = e.target;
          if (!(media instanceof HTMLMediaElement)) return;
          if (media.matches("audio[data-real-demo-audio]")) emit("demo_audio_play", { location: "recorded_demo" });
          // Exclude muted automatic viewport previews from commercial engagement.
          if (media.tagName === "VIDEO" && !media.muted) emit("commercial_play", { location: locationFor(media) });
        }, true);
        document.addEventListener("ended", e => {
          const media = e.target;
          if (media instanceof HTMLAudioElement && media.matches("audio[data-real-demo-audio]"))
            emit("demo_audio_complete", { location: "recorded_demo" });
        }, true);
        const pricing = document.querySelector("#pricing");
        if (pricing && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(entries => {
            if (entries.some(entry => entry.isIntersecting)) {
              emit("pricing_view", { location: "pricing" });
              observer.disconnect();
            }
          }, { threshold: .35 });
          observer.observe(pricing);
        }
        const industry = document.querySelector("[data-trade-page]");
        if (industry) emit("trade_page_view", { trade: industry.getAttribute("data-trade-page") });
      })();
    </script>
    {filled(GHL_CHAT_WIDGET) && <Fragment set:html={GHL_CHAT_WIDGET} />}
  </body>
</html>

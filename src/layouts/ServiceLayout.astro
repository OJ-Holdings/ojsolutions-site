---
// Shared layout for every service page. A service page is a landing page
// on its own: hero, the problem, its own sections, FAQ, and a final call
// to action. Every Book a call button on the page is tagged with the
// service, e.g. /book?service=website.
//
// Slots: "hero-secondary" sits next to the hero's Book a call button,
// "hero-note" sits under the hero buttons, "hero-aside" puts proof beside
// the hero copy, "problem" fills the problem section, "problem-aside" puts a
// visual beside it, and the default slot holds the page's own sections.
//
// To add a service: copy src/pages/websites.astro, change the words,
// and add the service to SERVICES in src/lib/site.ts.
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FaqSection, { type FaqItem } from "../components/FaqSection.astro";
import FinalCta from "../components/FinalCta.astro";
import type { ServiceKey } from "../lib/site";

interface Props {
  service: ServiceKey;
  /** Browser tab and search result title */
  title: string;
  /** Search result and link preview description */
  description: string;
  /** Service name shown above the headline */
  eyebrow: string;
  heading: string;
  /** Part of the headline to underline in gold */
  highlight?: string;
  subhead: string;
  problemHeading: string;
  faq: FaqItem[];
  ctaHeading: string;
  ctaLine?: string;
  /** Lead the hero and final call to action with the live AI demo line. */
  callFirst?: boolean;
}

const {
  service,
  title,
  description,
  eyebrow,
  heading,
  highlight,
  subhead,
  problemHeading,
  faq,
  ctaHeading,
  ctaLine,
  callFirst = false,
} = Astro.props;
const hasProblemAside = Astro.slots.has("problem-aside");
---

<BaseLayout title={title} description={description} service={service}>
  <Hero title={heading} highlight={highlight} subhead={subhead} eyebrow={eyebrow} service={service} callFirst={callFirst}>
    <slot name="hero-secondary" slot="secondary" />
    <slot name="hero-note" slot="note" />
    {Astro.slots.has("hero-aside") && <Fragment slot="aside"><slot name="hero-aside" /></Fragment>}
  </Hero>

  <Section id="problem" labelledby="problem-title" border={false}>
    <div class:list={[hasProblemAside && "grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-center lg:gap-16"]}>
      <div>
        <SectionHeading id="problem-title" title={problemHeading} />
        <slot name="problem" />
      </div>
      {hasProblemAside && <div><slot name="problem-aside" /></div>}
    </div>
  </Section>

  <slot />

  <FaqSection items={faq} />

  <FinalCta heading={ctaHeading} line={ctaLine} service={service} callFirst={callFirst} />
</BaseLayout>
